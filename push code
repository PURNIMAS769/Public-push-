Q4 — Network metrics available
fetch metric.series, from:-2h
| summarize series = count(), by:{metric.key}
| filter contains(metric.key, "net") or contains(metric.key, "nic")
   or contains(metric.key, "tcp") or contains(metric.key, "retrans")
   or contains(metric.key, "packet")
| sort series desc


fetch dt.davis.problems, from:-30d
| filter not(dt.davis.is_duplicate) and event.status == "ACTIVE"
| dedup display_id, sort:{timestamp desc}
| expand affected_entity_ids
| filter startsWith(affected_entity_ids, "HOST-")
| lookup [
    fetch dt.entity.host
    | fieldsAdd os = osType, mq = if(matchesValue(tags, "IBM MQ"), "yes", else:"no")
    | fields id, entity.name, os, mq
  ], sourceField:affected_entity_ids, lookupField:id, prefix:"host."
| filter isNotNull(host.os)
| fieldsAdd os_group = if(host.os == "ZOS", "Mainframe",
            else: if(host.mq == "yes" and in(host.os, "AIX", "LINUX", "WINDOWS"),
            host.os, else:"other"))
| filter os_group != "other"
| summarize
    problem_title    = takeFirst(event.name),
    severity         = takeFirst(event.category),
    status           = takeFirst(event.status),
    os_group         = takeFirst(os_group),
    affected_host    = takeFirst(host.entity.name),
    root_cause       = takeFirst(root_cause_entity_name),
    start_time       = takeFirst(event.start),
    problem_event_id = takeFirst(event.id),
    by:{display_id}
| fieldsAdd total_seconds = round((now() - start_time) / 1s, decimals:0)
| fieldsAdd hrs = floor(total_seconds / 3600), mins = floor((total_seconds % 3600) / 60)
| fieldsAdd age_formatted = concat(toString(hrs), "h ", toString(mins), "m")
| fieldsAdd alert_level = if(severity == "AVAILABILITY" and total_seconds > 300, "CRITICAL",
                          else: "WARNING")
| fieldsAdd problem_link = concat(
    "https://wdf17482.apps.dynatrace.com/ui/apps/dynatrace.davis.problems/problem/",
    problem_event_id, "?from=now()-24h&to=now()")
| sort start_time desc
| fields display_id, problem_title, severity, alert_level, status, os_group,
         affected_host, root_cause, start_time, age_formatted, problem_link

fetch dt.davis.problems, from:-30d
| filter not(dt.davis.is_duplicate) and event.status == "ACTIVE"
| expand hid = affected_entity_ids
| filter in(hid, array("HOST-71077A9B6F464D7D","HOST-57808AD7F7654592"))
| lookup [
    fetch dt.entity.host
    | fieldsAdd mq = if(matchesValue(tags, "IBM MQ"), "yes", else:"no")
    | fields id, osType, mq
  ], sourceField:hid, lookupField:id, prefix:"host."
| fields display_id, event.name, event.category, hid, host.osType, host.mq

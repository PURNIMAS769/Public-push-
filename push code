fetch dt.entity.cloud_application_namespace
| fields tags
| filter contains(lower(toString(tags)), "portfolio:claims")
| expand tag = tags
| filter contains(tag, "APMID:")
| fields apmid = splitString(tag, "APMID:")[1]
| append [
    fetch dt.entity.host
    | fields id, tags
    | expand tag = tags
    | fieldsAdd lt = lower(tag)
    | summarize claimVals = countDistinctExact(if(contains(lt, "portfolio:claims"), tag)),
                otherVals = countDistinctExact(if(contains(lt, "portfolio:") and not(contains(lt, "portfolio:claims")), tag)),
                apmids    = collectDistinct(if(contains(tag, "APMID:"), splitString(tag, "APMID:")[1])),
                by:{id}
    | filter claimVals > 0 and otherVals == 0
    | expand apmid = apmids
    | fields apmid
  ]
| filter isNotNull(apmid) and startsWith(apmid, "APP")
| dedup apmid
| sort apmid asc



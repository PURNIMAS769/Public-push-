| filter in(entity.name, array($Host_Name))
fetch `dt.entity.ibmmq:queue_manager`
| fields entity.name
| sort entity.name asc

fetch `dt.entity.ibmmq:queue_manager`
| filter contains(tags, "IBMMessageQueue-Distributed")
| fields id, entity.name, tags
| sort entity.name asc


timeseries oldest = avg(ibmmq.queue.oldest_message),
  by:{queue_manager},
  interval:1m
| fields queue_manager
| limit 10

fetch `dt.entity.ibmmq:local_queue`
| filter queue_manager_name == $queue_manager
| fields queue_name = entity.name
| sort queue_name asc

fetch `dt.entity.ibmmq:local_queue`
| fieldsAdd queue_manager, queue_name
| filter queue_manager == $Queue_Manager
| fields queue_name
| dedup queue_name
| sort queue_name asc
| limit 2000000

Step 2: Corrected tile
data record(apmid = array($ClaimsApps))
| expand apmid
// app → nodes
| lookup [
    timeseries cpu = avg(dt.kubernetes.container.cpu_usage), by:{k8s.namespace.name, k8s.node.name}, from:-30m
    | filter startsWith(k8s.namespace.name, "app")
    | fieldsAdd apmid = upper(substring(k8s.namespace.name, from:0, to:11))
    | summarize nodes = collectDistinct(k8s.node.name), by:{apmid}
  ], sourceField: apmid, lookupField: apmid, prefix: "m."
| expand nodeName = m.nodes
// Ready status: seen in last 24h, ready in last 15m
| lookup [
    timeseries c = avg(dt.kubernetes.node.conditions), by:{k8s.node.name, node_condition, condition_status}, from:-24h, interval:5m
    | filter node_condition == "Ready" and lower(condition_status) == "true"
    | fieldsAdd nodeName = k8s.node.name,
                recentMax = arrayMax(arraySlice(c, from:-3))
    | fieldsAdd notReady = isNull(recentMax) or recentMax < 1
    | fields nodeName, notReady
  ], sourceField: nodeName, lookupField: nodeName, prefix: "r."
// node ID → name, then active problems by ID
| lookup [
    fetch dt.davis.problems, from:-30d
    | sort timestamp desc
    | dedup display_id
    | filter event.status == "ACTIVE" and dt.davis.is_duplicate == false
    | expand nodeId = affected_entity_ids
    | filter startsWith(nodeId, "KUBERNETES_NODE-")
    | lookup [ fetch dt.entity.kubernetes_node | fields id, nName = entity.name ],
             sourceField: nodeId, lookupField: id, prefix: "e."
    | summarize nodeProblems = countDistinctExact(display_id),
                problemName = takeFirst(event.name), by:{nodeName = e.nName}
  ], sourceField: nodeName, lookupField: nodeName, prefix: "p."
| fieldsAdd notReady   = coalesce(r.notReady, false),
            hasProblem = coalesce(p.nodeProblems, 0) > 0
| summarize nodesTotal    = countDistinctExact(nodeName),
            nodesNotReady = countDistinctExact(if(notReady, nodeName)),
            nodesWithProb = countDistinctExact(if(hasProblem, nodeName)),
            badNodes      = arrayRemoveNulls(collectDistinct(if(notReady or hasProblem, nodeName))),
            problems      = arrayRemoveNulls(collectDistinct(p.problemName)),
            by:{apmid}
| fieldsAdd nodeHealth = if(nodesTotal == 0, "N/A",
                         else: if(nodesNotReady > 0 or nodesWithProb > 0, "🔴 Critical",
                         else: "🟢 Healthy"))
| fieldsAdd nodeReason = if(nodesNotReady > 0 and nodesWithProb > 0, "Node not ready + Davis problem",
                         else: if(nodesNotReady > 0, "Node down / not ready",
                         else: if(nodesWithProb > 0, "Davis problem on node", else: "-")))
| fieldsAdd rank = if(contains(nodeHealth, "Critical"), 1, else: if(contains(nodeHealth, "Healthy"), 2, else: 3))
| sort rank asc, apmid asc
| fields nodeHealth, apmid, nodesTotal, nodesNotReady, nodesWithProb, nodeReason, badNodes, problems

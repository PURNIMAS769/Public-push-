fetch dt.entity.service
| filter matchesValue(entity.name, "*ForgeRock*") or matchesValue(entity.name, "*forgerock*")
| fields id, entity.name, tags

fetch dt.entity.service
| filter arrayIndexOf(tags, "APMID:APP00005337") > -1
| fieldsAdd calls = toRelationships.calls[dt.entity.service]
| fields id, entity.name, calls
| expand calls


fetch dt.entity.service
| filter id in array("SERVICE-ED08AFC2412F0B3D","SERVICE-FD91B8527931BBC5","SERVICE-351C09747EC7439D")
| fields id, entity.name, tags


fetch dt.entity.service
| filter in(id, array("SERVICE-859BF5A856406B16","SERVICE-ED08AFC2412F0B3D","SERVICE-351C09747EC7439D"))
| fieldsAdd calling_service = "eliglock-ui"
| join [
    fetch spans, scanLimitGBytes: 100
    | filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APMID:APP00005337\")"))
    | summarize count = count(), by:{dt.entity.service}
], kind:leftOuter, on:{left[id] == right[dt.entity.service]}, prefix:"traffic."
| fields id, entity.name, traffic.count


fetch spans, from:-7d
| filter dt.entity.service == "SERVICE-5CD2D573FB852480" and span.kind == "client"
| fields trace.id
| dedup trace.id
| join [
    fetch spans, from:-7d
    | filter in(dt.entity.service, array("SERVICE-859BF5A856406B16","SERVICE-ED08AFC2412F0B3D","SERVICE-351C09747EC7439D")) and span.kind == "server"
    | fields trace.id, dt.entity.service
  ], kind:inner, on:{left[trace.id] == right[trace.id]}
| summarize count(), by:{dt.entity.service}
| sort count() desc

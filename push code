fetch dt.davis.problems
| filter not(dt.davis.is_duplicate) and event.status == "ACTIVE"
| filter in("IBMMessageQueue-Distributed", entity_tags)
| dedup display_id, sort:{timestamp desc}
| expand qname = affected_entity_names
| lookup [
    timeseries x = avg(ibmmq.queue.oldest_message), by:{queue_manager, queue_name}, from:-7d
    | summarize qm_count = countDistinct(queue_manager),
                qms = collectDistinct(queue_manager), by:{queue_name}
  ], sourceField:qname, lookupField:queue_name, prefix:"q."
| fields display_id, event.category, qname, q.qm_count, q.qms
| sort q.qm_count asc

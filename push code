fetch dt.davis.problems, from:-90d
| sort timestamp desc
| dedup display_id
| filter contains(event.name, "IBMMQ_APP")
| fieldsAdd apmid = concat("APP", substring(splitString(event.name, "IBMMQ_APP")[1], from:0, to:8))
| filter in(apmid, array($ClaimsApps))
| expand eid = affected_entity_ids
| lookup [ fetch `dt.entity.ibmmq:queue_manager` | fields id, qmName = entity.name ],
         sourceField: eid, lookupField: id, prefix: "qm."
| lookup [ fetch `dt.entity.ibmmq:local_queue` | fields id, qName = entity.name ],
         sourceField: eid, lookupField: id, prefix: "lq."
| summarize alerts = countDistinctExact(display_id),
            entityTypes = collectDistinct(affected_entity_types),
            qms = arrayRemoveNulls(collectDistinct(qm.qmName)),
            queues = arrayRemoveNulls(collectDistinct(lq.qName)),
            by:{apmid}
| sort alerts desc

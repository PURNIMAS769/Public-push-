fetch dt.entity.host
| filter in(ipAddress, array("10.56.3.136","10.57.2.173","10.58.1.185"))
| fields id, entity.name, ipAddress, tags

fetch spans, scanLimitGBytes: 100
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APMID:APP00005337\")"))
| filter in(server.address, array("10.56.3.136","10.57.2.173","10.58.1.185"))
| fields server.address, span.name, http.url, http.host, request.method, dt.entity.service
| limit 50

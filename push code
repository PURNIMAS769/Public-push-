V1 — Do problem tags carry Portfolio?

fetch dt.davis.problems, from:-7d
| fieldsAdd tagStr = toString(entity_tags)
| summarize total        = countDistinctExact(display_id),
            withClaims   = countDistinctExact(if(contains(lower(tagStr), "portfolio:claims"), display_id)),
            withApmid    = countDistinctExact(if(contains(tagStr, "APMID:"), display_id))x


Tile 1.4 — Active Claims problems (single value)

fetch dt.davis.problems, from:-7d
| sort timestamp desc
| dedup display_id
| filter event.status == "ACTIVE"
| filter dt.davis.is_duplicate == false
| filter contains(lower(toString(entity_tags)), "portfolio:claims")
| summarize activeProblems = countDistinctExact(display_id)


Tile 1.5 — Applications with active problems (single value)

fetch dt.davis.problems, from:-7d
| sort timestamp desc
| dedup display_id
| filter event.status == "ACTIVE"
| filter dt.davis.is_duplicate == false
| filter contains(lower(toString(entity_tags)), "portfolio:claims")
| expand tag = entity_tags
| filter startsWith(tag, "APMID:")
| fieldsAdd apmid = splitString(tag, "APMID:")[1]
| summarize appsImpacted = countDistinctExact(apmid)


Tile 1.6 — New Claims problems by category, last 7 days (stacked bar)

fetch dt.davis.problems, from:-7d
| sort timestamp desc
| dedup display_id
| filter dt.davis.is_duplicate == false
| filter contains(lower(toString(entity_tags)), "portfolio:claims")
| makeTimeseries problems = count(), by:{event.category}, time:event.start, interval:6h

The combined rollup tile (2.6)

Visual: Table. Set conditional colouring on the health column.

data record(apmid = array($ClaimsApps))
| expand apmid
// names + namespace count
| lookup [
    fetch dt.entity.cloud_application_namespace
    | fields id, name = entity.name, tags
    | expand tag = tags
    | filter startsWith(tag, "APMID:")
    | fieldsAdd apmid = splitString(tag, "APMID:")[1]
    | parse name, "LD '-' LD:nsName"
    | summarize nsName = takeFirst(nsName), namespaces = countDistinctExact(id), by:{apmid}
  ], sourceField: apmid, lookupField: apmid, prefix: "n."
// names for host-only apps
| lookup [
    fetch dt.entity.host
    | fields id, tags
    | expand tag = tags
    | filter startsWith(tag, "APMID:") or startsWith(tag, "APPName:")
    | summarize ids   = collectDistinct(if(startsWith(tag, "APMID:"), splitString(tag, "APMID:")[1])),
                names = collectDistinct(if(startsWith(tag, "APPName:"), splitString(tag, "APPName:")[1])),
                by:{id}
    | fieldsAdd ids = arrayRemoveNulls(ids), names = arrayRemoveNulls(names)
    | filter arraySize(ids) == 1 and arraySize(names) > 0
    | fieldsAdd apmid = ids[0],
                hostName = replaceString(replaceString(names[0], "_Test", ""), "_Dev", "")
    | summarize hostName = takeFirst(hostName), by:{apmid}
  ], sourceField: apmid, lookupField: apmid, prefix: "hn."
// total hosts (entity)
| lookup [
    fetch dt.entity.host
    | fields id, tags
    | expand tag = tags
    | filter startsWith(tag, "APMID:")
    | fieldsAdd apmid = splitString(tag, "APMID:")[1]
    | summarize hostsTotal = countDistinctExact(id), by:{apmid}
  ], sourceField: apmid, lookupField: apmid, prefix: "ht."
// hosts sending data in last 15 min
| lookup [
    timeseries cpu = avg(dt.host.cpu.usage), by:{dt.entity.host}, from:-15m
    | filter arraySize(arrayRemoveNulls(cpu)) > 0
    | lookup [ fetch dt.entity.host | fields id, tags ],
             sourceField: dt.entity.host, lookupField: id, prefix: "e."
    | expand tag = e.tags
    | filter startsWith(tag, "APMID:")
    | fieldsAdd apmid = splitString(tag, "APMID:")[1]
    | summarize hostsUp = countDistinctExact(dt.entity.host), by:{apmid}
  ], sourceField: apmid, lookupField: apmid, prefix: "hu."
// services tagged to one app only
| lookup [
    timeseries {req = sum(dt.service.request.count), fail = sum(dt.service.request.failure_count)},
               by:{dt.entity.service}, from:-1h
    | fieldsAdd req = arraySum(req), fail = arraySum(fail)
    | lookup [
        fetch dt.entity.service
        | fields id, tags
        | expand tag = tags
        | filter startsWith(tag, "APMID:")
        | summarize apmids = collectDistinct(splitString(tag, "APMID:")[1]), by:{id}
        | filter arraySize(apmids) == 1
        | fieldsAdd apmid = apmids[0]
        | fields id, apmid
      ], sourceField: dt.entity.service, lookupField: id, prefix: "e."
    | filter isNotNull(e.apmid)
    | summarize services = countDistinctExact(dt.entity.service),
                requests = sum(req), failures = sum(fail), by:{apmid = e.apmid}
    | fieldsAdd failRatePct = if(requests > 0, round(100.0 * failures / requests, decimals:2), else: 0.0)
  ], sourceField: apmid, lookupField: apmid, prefix: "s."
// container restarts
| lookup [
    timeseries restarts = sum(dt.kubernetes.container.restarts), by:{k8s.namespace.name}, from:-1h
    | fieldsAdd restarts = arraySum(restarts)
    | filter startsWith(k8s.namespace.name, "app")
    | fieldsAdd apmid = upper(substring(k8s.namespace.name, from:0, to:11))
    | summarize restarts1h = sum(restarts), by:{apmid}
  ], sourceField: apmid, lookupField: apmid, prefix: "k."
// active problems
| lookup [
    fetch dt.davis.problems, from:-30d
    | sort timestamp desc
    | dedup display_id
    | filter event.status == "ACTIVE" and dt.davis.is_duplicate == false
    | expand tag = entity_tags
    | filter startsWith(tag, "APMID:")
    | fieldsAdd apmid = splitString(tag, "APMID:")[1]
    | summarize activeProblems = countDistinctExact(display_id),
                categories = collectDistinct(event.category), by:{apmid}
    | fieldsAdd hasAvailability = contains(toString(categories), "AVAILABILITY")
  ], sourceField: apmid, lookupField: apmid, prefix: "p."
// defaults
| fieldsAdd appName        = coalesce(n.nsName, hn.hostName, apmid),
            namespaces     = coalesce(n.namespaces, 0),
            hostsTotal     = coalesce(ht.hostsTotal, 0),
            hostsUp        = coalesce(hu.hostsUp, 0),
            services       = coalesce(s.services, 0),
            requests       = coalesce(s.requests, 0),
            failRatePct    = coalesce(s.failRatePct, 0.0),
            restarts1h     = coalesce(k.restarts1h, 0),
            activeProblems = coalesce(p.activeProblems, 0),
            hasAvailability = coalesce(p.hasAvailability, false),
            categories     = p.categories
// health state
| fieldsAdd health = if(hasAvailability
                        or (failRatePct >= 10 and requests >= 100)
                        or (hostsTotal > 0 and hostsUp == 0), "🔴 Critical",
                     else: if(activeProblems > 0 or failRatePct >= 2
                        or hostsUp < hostsTotal or restarts1h >= 20, "🟠 Degraded",
                     else: if(services == 0 and namespaces == 0, "⚪ Unknown",
                     else: "🟢 Healthy")))
| fieldsAdd rank = if(contains(health, "Critical"), 1, else: if(contains(health, "Degraded"), 2,
                   else: if(contains(health, "Unknown"), 3, else: 4)))
| sort rank asc, activeProblems desc, failRatePct desc
| fields health, appName, apmid, hostsUp, hostsTotal, services, failRatePct,
         namespaces, restarts1h, activeProblems, categories

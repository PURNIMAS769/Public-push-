you select in the dashboard filter drives it:

fetch dt.davis.problems, from:-30d
| sort timestamp desc
| dedup display_id
| filter event.status == "ACTIVE" and dt.davis.is_duplicate == false
| expand tag = entity_tags
| filter startsWith(tag, "APMID:")
| fieldsAdd apmid = splitString(tag, "APMID:")[1]
| filter in(apmid, array($ClaimsApps))
| dedup display_id
| fields apmid, display_id, event.name, event.category, dt.davis.impact_level,
         event.start, affected_entity_types, affected_entity_ids,
         affected_entity_names, root_cause_entity_id, root_cause_entity_name
| sort apmid asc, event.start desc

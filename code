Tile 1: Top processes by CPU
timeseries cpu = avg(dt.process.cpu.usage),
           by:{dt.entity.process_group_instance}
| fieldsAdd `CPU (%)` = round(arrayAvg(cpu), decimals:1)
| lookup [
    fetch dt.entity.process_group_instance
    | fieldsAdd hostId = belongs_to[dt.entity.host]
    | fields id, Process = entity.name, hostId, tags
    | expand tag = tags
    | fieldsAdd tag = toString(tag)
    | summarize apmids = collectDistinct(if(contains(tag, "APMID:"), splitString(tag, "APMID:")[1],
                           else: if(contains(tag, "APPID:"), splitString(tag, "APPID:")[1]))),
                appNames = collectDistinct(if(contains(tag, "APPName:"), splitString(tag, "APPName:")[1])),
                by:{id, Process, hostId}
    | fieldsAdd apmid = apmids[0], AppName = coalesce(appNames[0], apmids[0])
    | filter in(apmid, array($ClaimsApps))
    | fields id, Process, hostId, AppName
  ], sourceField:dt.entity.process_group_instance, lookupField:id, prefix:"p."
| filter isNotNull(p.id)
| lookup [ fetch dt.entity.host | fields id, Host = entity.name ],
    sourceField:p.hostId, lookupField:id, prefix:"h."
| fields `App Name` = p.AppName, Process = p.Process, Host = h.Host, `CPU (%)`
| sort `CPU (%)` desc
| limit 10


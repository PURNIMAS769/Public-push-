fetch dt.entity.host
| expand tags
| filter toString(tags) == "MongoDB_Supported"
| summarize count(), by:{ host_name = entity.name }
| fields host_name
| sort host_name asc

fetch `dt.entity.mongodb:process`
| summarize count(), by:{ process_name = entity.name }
| fields process_name
| sort process_name asc


fetch dt.entity.mongodb:replicaset
| summarize count(), by:{ rs_name = entity.name }
| fields rs_name
| sort rs_name asc


| filter in(host_name, array($db2_host))


timeseries series = sum(mongodb.db.objects), by:{dt.entity.mongodb:database}
| lookup [ fetch dt.entity.mongodb:database | fields id, db_name = entity.name ],
    sourceField:dt.entity.mongodb:database, lookupField:id, prefix:"d_"
| summarize count(), by:{ db_name = d_db_name }
| fields db_name
| sort db_name asc

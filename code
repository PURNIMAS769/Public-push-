timeseries
    limits_cpu = avg(dt.kubernetes.container.limits_cpu, default:0),
    requests_cpu = avg(dt.kubernetes.container.requests_cpu, default:0),
    limits_memory = avg(dt.kubernetes.container.limits_memory, default:0),
    requests_memory = avg(dt.kubernetes.container.requests_memory, default:0),
    by:{k8s.cluster.name, k8s.namespace.name, k8s.container.name},
    from:-1h
| filter k8s.namespace.name == "app00002734-paperless-inventory"
| fieldsAdd `Limits CPU` = arrayLast(limits_cpu), `Requests CPU` = arrayLast(requests_cpu)
| fieldsAdd `Limits Memory (MB)` = round(arrayLast(limits_memory)/1048576, decimals:1)
| fieldsAdd `Requests Memory (MB)` = round(arrayLast(requests_memory)/1048576, decimals:1)
| fields k8s.cluster.name, k8s.container.name, `Limits CPU`, `Requests CPU`, `Limits Memory (MB)`, `Requests Memory (MB)`
| sort k8s.cluster.name asc

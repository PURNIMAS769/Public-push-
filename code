fetch spans, from:-2h, scanLimitGBytes: 200
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APMID:APP00006805\")"))
| filter span.kind == "client"
| filter contains(server.address, "stv-ig") or contains(server.address, "sso-sg")
| summarize count(), by:{server.address}
| sort count() desc

fetch spans, from:-2h, scanLimitGBytes: 200
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APMID:APP00006805\")"))
| filter contains(server.address, "sso-sg")
| fieldsAdd endpoint = concat(toString(span.name), " ", toString(url.path))
| summarize op_count = count(), by:{endpoint}
| sort op_count desc

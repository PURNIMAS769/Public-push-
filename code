data record(apmid = array($ClaimsApps))
| expand apmid
// app -> queues (90d alert history) -> queue managers (queue depth metric)
| lookup [
    fetch dt.davis.problems, from:-90d
    | sort timestamp desc
    | dedup display_id
    | filter contains(event.name, "IBMMQ_APP")
    | fieldsAdd apmid = concat("APP", substring(splitString(event.name, "IBMMQ_APP")[1], from:0, to:8))
    | expand eid = affected_entity_ids
    | lookup [ fetch `dt.entity.ibmmq:local_queue` | fields id, qName = entity.name ],
             sourceField: eid, lookupField: id, prefix: "lq."
    | filter isNotNull(lq.qName)
    | summarize alerts = count(), by:{apmid, queueName = lq.qName}
    | lookup [
        timeseries d = avg(ibmmq.queue.depth), by:{queue_manager, queue_name}, from:-24h
        | summarize qms = collectDistinct(queue_manager), by:{queue_name}
      ], sourceField: queueName, lookupField: queue_name, prefix: "m."
    | expand qm = m.qms
    | filter isNotNull(qm)
    | summarize qms = collectDistinct(qm), by:{apmid}
  ], sourceField: apmid, lookupField: apmid, prefix: "map."
| filter isNotNull(map.qms)
| expand qmName = map.qms
// queue manager availability, MQ server name and host ID
| lookup [
    timeseries a = avg(ibmmq.queue_manager.availability),
               by:{queue_manager, host.name, dt.entity.host}, from:-24h, interval:5m
    | fieldsAdd recent = arrayMax(arraySlice(a, from:-3))
    | summarize reporting = countIf(isNotNull(recent)),
                minAvail  = min(recent),
                server    = takeFirst(host.name),
                hostId    = takeFirst(dt.entity.host),
                by:{queue_manager}
  ], sourceField: qmName, lookupField: queue_manager, prefix: "a."
// queue manager entity ID (Fix 2)
| lookup [
    fetch `dt.entity.ibmmq:queue_manager`
    | fields qmEntityId = id, qmEntityName = entity.name
  ], sourceField: qmName, lookupField: qmEntityName, prefix: "e."
// active "queue manager unavailable" alerts
| lookup [
    fetch dt.davis.problems, from:-30d
    | sort timestamp desc
    | dedup display_id
    | filter event.status == "ACTIVE" and dt.davis.is_duplicate == false
    | filter contains(lower(event.name), "queue_manager is unavailable")
          or contains(lower(event.name), "queue manager is unavailable")
    | expand eid = affected_entity_ids
    | lookup [ fetch `dt.entity.ibmmq:queue_manager` | fields id, qmN = entity.name ],
             sourceField: eid, lookupField: id, prefix: "x."
    | filter isNotNull(x.qmN)
    | summarize qmAlerts = countDistinctExact(display_id), by:{qmName = x.qmN}
  ], sourceField: qmName, lookupField: qmName, prefix: "q."
| fieldsAdd noData = isNull(a.reporting) or a.reporting == 0,
            down   = coalesce(a.minAvail, 0) < 100 or coalesce(q.qmAlerts, 0) > 0
| fieldsAdd status = if(not(noData) and down, "🔴 Critical",
                     else: if(noData, "⚪ No data", else: "🟢 Healthy")),
            rank   = if(not(noData) and down, 1, else: if(noData, 2, else: 3))
| fieldsAdd appServerQm = concat(apmid, " | ", coalesce(a.server, "host n/a"), " : ", qmName)
| fields status, appServerQm,
         availPct = round(a.minAvail, decimals:1),
         alerts   = coalesce(q.qmAlerts, 0),
         `dt.entity.ibmmq:queue_manager` = e.qmEntityId,
         dt.entity.host = a.hostId,
         rank
| sort rank asc, appServerQm asc
| fieldsRemove rank


What changed from the version you ran

dt.entity.ibmmq:queue_manager column: it holds the queue manager's own entity ID. I named it after the entity type because "Open with" matches on the field name. I haven't confirmed that this name is what your tenant needs.
dt.entity.host column: the MQ server's host ID, as in Fix 1.
host n/a label: it replaces ? for queue managers with no host name.
Prefix rename: the inner prefix in the alerts lookup is now x., so it doesn't clash with the new e. prefix.

How to test

Hide both ID columns in Visual → Table → Columns, but keep them in the query.
Use ⋮ → Open with… on the dt.entity.ibmmq:queue_manager cell. If it still says "No compatible intents found", no installed app handles that entity type, and no query change will fix it. Then use the dt.entity.host cell and choose Hosts.


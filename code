timeseries page_faults = avg(dt.host.memory.avail.pfps, scalar:true),
by: { dt.entity.host },
from:-7d, interval:1h
| fieldsAdd host.name = entityName(dt.entity.host)
| fieldsAdd id = dt.entity.host
| join [
    fetch dt.entity.host
    | fieldsAdd category = if(in(id, classicEntitySelector("type(HOST),hostVirtualizationType(PHYSICAL_HOST)")),
        "Physical",
        else: if(in(id, classicEntitySelector("type(HOST),hypervisorType(VMWARE)")),
        "Virtual",
        else: if(in(id, classicEntitySelector("type(HOST),cloudType(AZURE)")),
        "Azure", else: "Others")))
    | filter category == "Physical"
    | filter contains(toString(tags), "AYS:MSP_Windows")
    | fields id
], kind: inner, on: { id }
| fieldsAdd raw_pct = round((page_faults / 250) * 100, decimals: 2)
| fieldsAdd page_fault_pct = if(raw_pct > 100, 100, else: raw_pct)
| fieldsAdd fault_status = if(page_faults > 245.38, "CRITICAL",
    else: if(page_faults > 72.95, "HIGH",
    else: if(page_faults > 0.09, "ELEVATED", else: "NORMAL")))
| fields
`Host Name` = host.name,
`Page Faults/sec` = round(page_faults, decimals: 2),
`Page Fault Load %` = page_fault_pct,
`Fault Status` = fault_status, dt.entity.host

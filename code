fetch dt.davis.problems, from:-30d
| sort timestamp desc
| dedup display_id
| filter event.status == "ACTIVE" and dt.davis.is_duplicate == false
| filter contains(event.name, "IBMMQ")
      or contains(lower(event.name), "queue manager")
      or contains(lower(event.name), "queue_manager")
      or contains(lower(event.name), "dead-letter")
      or contains(lower(event.name), "dead letter")
      or contains(lower(toString(affected_entity_types)), "ibmmq")
// Claims APMID is carried in the alert name (IBMMQ_APP<id>)
| fieldsAdd nameApmid = if(contains(event.name, "IBMMQ_APP"),
                           concat("APP", substring(splitString(event.name, "IBMMQ_APP")[1], from:0, to:8)))
// readable queue / queue manager names
| expand eid = affected_entity_ids
| lookup [ fetch `dt.entity.ibmmq:queue_manager` | fields id, qmName = entity.name ],
         sourceField: eid, lookupField: id, prefix: "qm."
| lookup [ fetch `dt.entity.ibmmq:local_queue` | fields id, qName = entity.name ],
         sourceField: eid, lookupField: id, prefix: "lq."
| fieldsAdd mqEntity = coalesce(lq.qName, qm.qmName)
| summarize affected = arrayToString(arrayRemoveNulls(collectDistinct(mqEntity)), delimiter:", "),
            alert    = takeFirst(event.name),
            category = takeFirst(event.category),
            started  = takeFirst(event.start),
            nameApmid = takeFirst(nameApmid),
            by:{display_id}
| fieldsAdd isClaims = coalesce(in(nameApmid, array($ClaimsApps)), false)
| fieldsAdd scope  = if(isClaims, "Claims app", else: "Shared MQ platform / other"),
            status = "🔴 Active",
            openFor = now() - started,
            rank   = if(isClaims, 1, else: 2)
| fields status, scope, app = coalesce(nameApmid, "-"), alert, affected = coalesce(affected, "-"),
         category, display_id, openFor, rank
| sort rank asc, openFor desc
| fieldsRemove rank



CPU Usage — with time range added
fetch dt.entity.host
| filter arrayIndexOf(tags, "APMID:APP00005497") != -1
| fields id, hostname = entity.name

| join [
    timeseries cpu = avg(dt.host.cpu.usage, scalar:true), by:{dt.entity.host}, from:-15d, interval:1h
  ], kind:leftOuter, on: left[id] == right[dt.entity.host]
| fieldsAdd cpu_avg_pct = round(right.cpu, decimals:2)

| fields hostname, cpu_avg_pct, id
| sort cpu_avg_pct desc


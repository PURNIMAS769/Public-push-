This is the full MQ Health tile with the one-row ending (Total Apps, Healthy, Unhealthy):

data record(apmid = array($ClaimsApps))
| expand apmid
// app → queues (90d alert history) → queue managers (queue depth metric)
| lookup [
    fetch dt.davis.problems, from:-90d
    | sort timestamp desc
    | dedup display_id
    | filter contains(event.name, "IBMMQ_APP")
    | fieldsAdd apmid = concat("APP", substring(splitString(event.name, "IBMMQ_APP")[1], from:0, to:8))
    | expand eid = affected_entity_ids
    | lookup [ fetch `dt.entity.ibmmq:local_queue` | fields id, qName = entity.name ],
             sourceField: eid, lookupField: id, prefix: "lq."
    | filter isNotNull(lq.qName)
    | summarize alerts = count(), by:{apmid, queueName = lq.qName}
    | lookup [
        timeseries d = avg(ibmmq.queue.depth), by:{queue_manager, queue_name}, from:-24h
        | summarize qms = collectDistinct(queue_manager), by:{queue_name}
      ], sourceField: queueName, lookupField: queue_name, prefix: "m."
    | expand qm = m.qms
    | filter isNotNull(qm)
    | summarize qms = collectDistinct(qm), by:{apmid}
  ], sourceField: apmid, lookupField: apmid, prefix: "map."
| expand qmName = map.qms
// QM availability: reported in 24h, available in last 15m
| lookup [
    timeseries a = avg(ibmmq.queue_manager.availability), by:{queue_manager}, from:-24h, interval:5m
    | fieldsAdd qmName = queue_manager, recentMax = arrayMax(arraySlice(a, from:-3))
    | fieldsAdd qmDown = isNull(recentMax) or recentMax < 1
    | fields qmName, qmDown
  ], sourceField: qmName, lookupField: qmName, prefix: "a."
// active "Queue manager is unavailable" alerts, matched by QM entity
| lookup [
    fetch dt.davis.problems, from:-30d
    | sort timestamp desc
    | dedup display_id
    | filter event.status == "ACTIVE" and dt.davis.is_duplicate == false
    | filter contains(lower(event.name), "queue_manager is unavailable")
          or contains(lower(event.name), "queue manager is unavailable")
    | expand eid = affected_entity_ids
    | lookup [ fetch `dt.entity.ibmmq:queue_manager` | fields id, qmN = entity.name ],
             sourceField: eid, lookupField: id, prefix: "e."
    | filter isNotNull(e.qmN)
    | summarize qmAlert = count(), by:{qmName = e.qmN}
  ], sourceField: qmName, lookupField: qmName, prefix: "qa."
// active MQ alerts carrying the app's APMID
| lookup [
    fetch dt.davis.problems, from:-30d
    | sort timestamp desc
    | dedup display_id
    | filter event.status == "ACTIVE" and dt.davis.is_duplicate == false
    | filter contains(event.name, "IBMMQ_APP")
    | fieldsAdd apmid = concat("APP", substring(splitString(event.name, "IBMMQ_APP")[1], from:0, to:8))
    | summarize mqAlerts = countDistinctExact(display_id), by:{apmid}
  ], sourceField: apmid, lookupField: apmid, prefix: "p."
| fieldsAdd qmBad = coalesce(a.qmDown, false) or coalesce(qa.qmAlert, 0) > 0
| summarize qmTotal    = countDistinctExact(qmName),
            qmNotAvail = countDistinctExact(if(qmBad, qmName)),
            mqAlerts   = takeFirst(p.mqAlerts),
            by:{apmid}
| fieldsAdd mqAlerts = coalesce(mqAlerts, 0)
| filter qmTotal > 0 or mqAlerts > 0
| fieldsAdd Status = if(qmNotAvail > 0 or mqAlerts > 0, "Unhealthy", else: "Healthy")
| summarize `Total Apps` = count(),
            Healthy      = countIf(Status == "Healthy"),
            Unhealthy    = countIf(Status == "Unhealthy")



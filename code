fetch spans, from:-7d
| filter in(dt.entity.service, classicEntitySelector("type(service),entityName.equals(\"DP0C\")"))
    or in(dt.entity.service, classicEntitySelector("type(service),entityName.equals(\"ODSPRDDA\")"))
| summarize count()


fetch spans, scanLimitGBytes: 600, from:-7d
| filter in(dt.entity.service, classicEntitySelector("type(service),entityName.equals(\"DP0C\")"))
    or in(dt.entity.service, classicEntitySelector("type(service),entityName.equals(\"ODSPRDDA\")"))
| summarize count(), by:{span.name}
| sort `count()` desc
| limit 30

fetch spans, scanLimitGBytes: 600, from:-7d
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APPName:Blue_Chip_Benefit_Determination_Prod\")"))
| summarize count(), by:{span.name}
| sort `count()` desc
| limit 30

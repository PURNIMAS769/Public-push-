fetch dt.entity.service
| filter arrayIndexOf(tags, "APMID:APP00005337") > -1 or arrayIndexOf(tags, "APPName:Blue_Chip_Eligibility__BCE__Prod") > -1
| fieldsAdd pgi = runs_on[dt.entity.process_group_instance]
| fieldsAdd host = runs_on[dt.entity.host]
| fieldsAdd matched_apmid = arrayIndexOf(tags, "APMID:APP00005337") > -1
| fieldsAdd matched_appname = arrayIndexOf(tags, "APPName:Blue_Chip_Eligibility__BCE__Prod") > -1
| fields id, entity.name, pgi, host, matched_apmid, matched_appname

timeseries total_requests = sum(dt.service.request.count), from:-24h
| filter dt.entity.service == "SERVICE-F65400876ACCE3AA"


timeseries avg_response_time = avg(dt.service.request.response_time), from:-24h
| filter dt.entity.service == "SERVICE-F65400876ACCE3AA"


timeseries
    total_requests = sum(dt.service.request.count),
    failed_requests = sum(dt.service.request.failure_count),
    from:-24h
| filter dt.entity.service == "SERVICE-F65400876ACCE3AA"
| fieldsAdd total_sum = arraySum(total_requests), failed_sum = arraySum(failed_requests)
| fieldsAdd failure_rate_pct = round((failed_sum / total_sum) * 100, decimals:2)


timeseries avg(dt.osservice.availability), from:-24h
| filter dt.entity.service == "SERVICE-F65400876ACCE3AA"


fetch spans, from:-24h
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APMID:APP00006805\")"))
| filter span.name == "CONNECT DP0C" or span.name == "SELECT DP0C" or span.name == "PREPARE DP0C"
| summarize op_count = count(), by:{dt.entity.service, span.name}
| fieldsAdd service_name = entityName(dt.entity.service)
| fields service_name, span.name, op_count
| sort op_count desc


fetch spans, from:-24h
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APMID:APP00006805\")"))
| filter span.name == "CONNECT DP0C" or span.name == "SELECT DP0C" or span.name == "PREPARE DP0C"
| summarize op_count = count(), by:{bin(timestamp, 1h), span.name}
| sort timestamp asc

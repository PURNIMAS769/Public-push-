timeseries lock_waits = avg(`sql-server.locks.byWaitType`),
by:{device.name, wait_type},
from:-30d
| filter contains(device.name, "wpisq")
| filter startsWith(wait_type, "LCK_")
| fields timeframe, interval, device.name, wait_type, lock_waits




timeseries lock_waits = avg(`sql-server.locks.byWaitType`),
from:-30d,
filter: device.name == "twauswpisq04.adhcsctst.net" and wait_type == "LCK_M_U"
| fields timeframe, interval, lock_waits






timeseries page_faults = avg(dt.host.memory.avail.pfps, scalar:true),
by: { dt.entity.host },
from:-7d, interval:1h
| fieldsAdd host.name = entityName(dt.entity.host)
| summarize
    min_pf = min(page_faults),
    avg_pf = avg(page_faults),
    p50_pf = percentile(page_faults, 50),
    p90_pf = percentile(page_faults, 90),
    p99_pf = percentile(page_faults, 99),
    max_pf = max(page_faults)

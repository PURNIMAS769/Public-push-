Discovery Query 1 — Does an Availability Group entity exist for these SQL hosts?
fetch dt.entity.sql_server_availability_group
| fields id, ag_name = entity.name

Discovery Query 2 — Confirm replication/failover metrics are collecting
fetch metric.series
| filter contains(metric.key, "sql-server") and (contains(metric.key, "replicat") or contains(metric.key, "failover") or contains(metric.key, "avail"))
| summarize count(), by:{metric.key}
| sort metric.key asc

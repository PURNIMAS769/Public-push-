fetch `dt.entity.mongodb:process`
| fieldsAdd process_id = id, process_name = entity.name
| lookup [
    timeseries current_queue = avg(mongodb.locks.global_current_queue, scalar:true), by:{`dt.entity.mongodb:process`}, from:-2h
  ], sourceField:process_id, lookupField:`dt.entity.mongodb:process`, prefix:"m_"
| fields process_name, current_global_queue = round(m_current_queue, decimals:0)
| sort current_global_queue desc


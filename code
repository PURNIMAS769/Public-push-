E1: databases not ONLINE, with history

timeseries st = max(`sql-server.databases.state`),
           by:{device.name, database}, from:-7d, interval:1h
| fieldsAdd stClean  = arrayRemoveNulls(st)
| fieldsAdd nowState = arrayLast(stClean), minState = arrayMin(stClean),
            hostShort = lower(splitString(device.name, ".")[0])
| filter nowState > 0
| lookup [
    fetch dt.entity.host
    | fields hostName = entity.name, tags
    | expand t = tags
    | filter startsWith(t, "APMID:")
    | fieldsAdd apmid = splitString(t, "APMID:")[1],
                hostShort = lower(splitString(hostName, ".")[0])
    | filter in(apmid, array($MembershipApps))
    | summarize apps = collectDistinct(apmid), by:{hostShort}
  ], sourceField: hostShort, lookupField: hostShort, prefix: "h."
| filter isNotNull(h.apps)
| fieldsAdd stateName = if(nowState == 6, "OFFLINE", else: if(nowState == 5, "EMERGENCY",
                        else: if(nowState == 4, "SUSPECT", else: if(nowState == 3, "RECOVERY_PENDING",
                        else: if(nowState == 2, "RECOVERING", else: "RESTORING"))))),
            history   = if(minState == 0, "Recent change", else: "Long-term (7d+)"),
            apps      = arrayToString(h.apps, delimiter:", ")
| fields history, stateName, server = device.name, database, apps
| sort history asc, stateName asc


E2: Always On groups on Membership hosts

timeseries h = max(`sql-server.always-on.db.synchronizationHealth`, scalar: true),
           by:{device.name, availability.database.name,
               availability.database.synchronization_health,
               availability.database.synchronization_state}, from:-30m
| fieldsAdd hostShort = lower(splitString(device.name, ".")[0])
| lookup [
    fetch dt.entity.host
    | fields hostName = entity.name, tags
    | expand t = tags
    | filter startsWith(t, "APMID:")
    | fieldsAdd apmid = splitString(t, "APMID:")[1],
                hostShort = lower(splitString(hostName, ".")[0])
    | filter in(apmid, array($MembershipApps))
    | summarize apps = collectDistinct(apmid), by:{hostShort}
  ], sourceField: hostShort, lookupField: hostShort, prefix: "h."
| filter isNotNull(h.apps)
| summarize databases = count(),
            by:{availability.database.synchronization_health, availability.database.synchronization_state}



timeseries disk_usage = avg(dt.kubernetes.node.filesystem_used), disk_total = avg(dt.kubernetes.node.filesystem_capacity),
    by:{k8s.node.name},
    filter: k8s.namespace.name == "app00006805-accums-adjudication",
    from:-24h


fetch dt.entity.cloud_application_instance
| filter namespaceName == "app00006805-accums-adjudication"
| fieldsAdd entity.name, volumes
| limit 5



fetch metric.series
| filter contains(metric.key, "kubernetes") and (contains(metric.key, "disk") or contains(metric.key, "filesystem") or contains(metric.key, "volume") or contains(metric.key, "storage"))
| summarize count(), by:{metric.key}

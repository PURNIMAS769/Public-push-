timeseries availability = avg(ibmmq.queue_manager.availability),
  by:{`dt.entity.ibmmq:queue_manager`}
| fieldsAdd queue_manager = entityName(`dt.entity.ibmmq:queue_manager`)
| fields queue_manager, availability
| filter in(queue_manager,
    array("HCSC1P", "MULEPRD1", "MULEPRD3"))
| sort queue_manager asc

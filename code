fetch `dt.entity.sql:db2_instance`
| fieldsAdd host_ref = runs_on[`dt.entity.sql:db2_host`]
| lookup [
    fetch `dt.entity.sql:db2_host`
    | fieldsAdd host_key = toLowercase(splitString(Hostname, ".")[0])
    | fields id, host_key
  ], sourceField:host_ref, lookupField:id, prefix:"h_"
| filter isNotNull(h_host_key)
| lookup [
    fetch dt.entity.host
    | filter in(id, classicEntitySelector("type(HOST),tag(\"AIXDB2\")"))
        or in(id, classicEntitySelector("type(HOST),tag(\"LinuxDB2\")"))
    | fieldsAdd host_name = entity.name
    | filter in(host_name, array($host))
    | fieldsAdd host_key = toLowercase(splitString(host_name, ".")[0])
    | fields host_key, selected_host = host_name
  ], sourceField:h_host_key, lookupField:host_key, prefix:"s_"
| filter isNotNull(s_selected_host)
| fieldsAdd instance_name = entity.name
| filter isNotNull(instance_name)
| summarize count(), by:{instance_name}
| fields instance_name
| sort instance_name asc

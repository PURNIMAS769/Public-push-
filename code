fetch dt.davis.events, from:-30d
| expand affected_entity_ids
| lookup [
    fetch dt.entity.cloud_application
    | filter arrayIndexOf(tags, "APMID:APP00006805") > -1
    | fields id, entity.name
], sourceField: affected_entity_ids, lookupField: id, fields: { deployment_name = entity.name }
| filter isNotNull(deployment_name)
| summarize event_count = count(), by:{event.type, event.name}
| sort event_count desc

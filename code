timeseries
    running_pods = sum(dt.kubernetes.pods, filter: pod_phase == "Running"),
    desired_pods = avg(dt.kubernetes.workload.pods_desired),
    by:{dt.entity.cloud_application},
    from:-15m
| fieldsAdd deployment_name = entityName(dt.entity.cloud_application)
| filter arrayIndexOf(deployment_name, "pprlessinv") >= 0 or contains(deployment_name, "pprlessinv")
| fieldsAdd running = arrayLast(running_pods), desired = arrayLast(desired_pods)
| fieldsAdd status_pct = round((running / desired) * 100, decimals:1)
| fields deployment_name, running, desired, status_pct

timeseries oplog_size = avg(mongodb.rs.oplog_size), by:{dt.entity.mongodb:replicaset}, from:-2h
| lookup [ fetch dt.entity.mongodb:replicaset | fields id, rs_name = entity.name ],
    sourceField:dt.entity.mongodb:replicaset, lookupField:id, prefix:"r_"
| fieldsAdd oplog_size_mb = oplog_size / 1024 / 1024
| fields rs_name = r_rs_name, oplog_size_mb, timeframe, interval

fetch `dt.entity.mongodb:process`, from:-24h
| fieldsAdd process_name = entity.name, is_running = if(lifetime[end] > now() - 15m, true, else: false)

// — Liveness: heartbeat via mongodb.uptime —
| lookup [
    timeseries latest = avg(mongodb.uptime), by:{`dt.entity.mongodb:process`}, from:-15m
    | fieldsAdd latest_reported = if(isNotNull(arrayLast(latest)), 1, else: 0)
  ], sourceField:id, lookupField:`dt.entity.mongodb:process`, prefix:"m_"

// — Any active Davis problem directly on this process entity —
| lookup [
    fetch dt.davis.problems
    | filter not(dt.davis.is_duplicate) and event.status == "ACTIVE"
    | expand affected_entity_ids
    | summarize open_pids = countDistinct(event.id), by:{affected_entity_ids}
  ], sourceField:id, lookupField:affected_entity_ids, prefix:"p_"

| fieldsAdd open_pids = coalesce(p_open_pids, 0)
| fieldsAdd health_status = if(
    is_running == false or m_latest_reported == 0 or open_pids > 0,
    "UNHEALTHY", else: "HEALTHY"
  )

// — Roll up into totals for this tile —
| summarize
    total_processes = count(),
    healthy = countIf(health_status == "HEALTHY"),
    unhealthy = countIf(health_status == "UNHEALTHY")

fetch dt.entity.mongodb:database
| fieldsAdd db_id = id, db_name = entity.name
| lookup [
    timeseries objects = avg(mongodb.db.objects, scalar:true), by:{dt.entity.mongodb:database}, from:-2h
  ], sourceField:db_id, lookupField:dt.entity.mongodb:database, prefix:"o_"
| lookup [
    timeseries data_size = avg(mongodb.db.db_data_size, scalar:true), by:{dt.entity.mongodb:database}, from:-2h
  ], sourceField:db_id, lookupField:dt.entity.mongodb:database, prefix:"d_"
| fields db_name,
    objects = round(o_objects, decimals:0),
    data_size_mb = round(d_data_size / 1024 / 1024, decimals:2)
| sort data_size_mb desc

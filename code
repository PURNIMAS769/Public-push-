A6 — actual DB2/MSSQL/Mongo/MQ metric presence (settles the tag-vs-reality gap)

fetch metric.series, from:-2h
| summarize series = count(), by:{metric.key}
| filter contains(metric.key, "db2") or contains(metric.key, "mssql")
   or contains(metric.key, "mongo") or contains(metric.key, "mq")
| sort series desc

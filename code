timeseries availability_mode = avg(`sql-server.always-on.ar.availabilityMode`),
           failover_mode = avg(`sql-server.always-on.ar.failoverMode`)


timeseries availability_mode = avg(`sql-server.always-on.ar.availabilityMode`), by:{dt.entity.custom_device}



fetch metric.series
| filter contains(metric.key, "always-on")
| fieldsAdd sample = arrayFirst(metric.key)
| fields metric.key
| limit 10

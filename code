Step 1: the core variable (17 apps)

Create the variable the same way as before: Name MembershipApps, Type Query, Multi-select on, Default select all.

fetch dt.entity.cloud_application_namespace
| fields tags
| filter contains(lower(replaceString(toString(tags), "_", " ")), "portfolio:commercial markets")
| expand tag = tags
| filter contains(tag, "APMID:")
| fields apmid = splitString(tag, "APMID:")[1]
| filter isNotNull(apmid) and matchesPattern(apmid, "'APP' DIGIT{8}")
| dedup apmid
| sort apmid asc


Step 2: review the host-only candidates

This lists every APMID with how many namespaces and hosts it comes from. Hosts only count when they carry no other portfolio tag, as in the Claims variable.

fetch dt.entity.cloud_application_namespace
| fields tags
| filter contains(lower(replaceString(toString(tags), "_", " ")), "portfolio:commercial markets")
| expand tag = tags
| filter contains(tag, "APMID:")
| fields apmid = splitString(tag, "APMID:")[1], src = "namespace", hostName = toString(null)
| append [
    fetch dt.entity.host
    | fields id, hostName = entity.name, tags
    | expand tag = tags
    | fieldsAdd lt = lower(replaceString(tag, "_", " "))
    | summarize cmVals    = countDistinctExact(if(contains(lt, "portfolio:commercial markets"), tag)),
                otherVals = countDistinctExact(if(contains(lt, "portfolio:") and not(contains(lt, "portfolio:commercial markets")), tag)),
                apmids    = collectDistinct(if(contains(tag, "APMID:"), splitString(tag, "APMID:")[1])),
                by:{id, hostName}
    | filter cmVals > 0 and otherVals == 0
    | expand apmid = apmids
    | fields apmid, src = "host", hostName
  ]
| filter isNotNull(apmid) and matchesPattern(apmid, "'APP' DIGIT{8}")
| summarize namespaces = countIf(src == "namespace"),
            hosts      = countIf(src == "host"),
            sampleHost = takeFirst(hostName),
            by:{apmid}
| fieldsAdd source = if(namespaces > 0 and hosts > 0, "both",
                     else: if(namespaces > 0, "namespace", else: "host-only"))
| sort source asc, hosts desc

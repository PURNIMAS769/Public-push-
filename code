timeseries
    received = sum(dt.kubernetes.pod.network_received_data),
    transmitted = sum(dt.kubernetes.pod.network_transmitted_data),
    by:{k8s.namespace.name},
    from:-24h
| filter k8s.namespace.name == "app00002734-paperless-inventory"
| fields timeframe, interval, k8s.namespace.name, received, transmitted


timeseries
    dropped_rx = sum(dt.kubernetes.pod.network_received_packets_dropped),
    dropped_tx = sum(dt.kubernetes.pod.network_transmitted_packets_dropped),
    by:{k8s.namespace.name},
    from:-24h
| filter k8s.namespace.name == "app00002734-paperless-inventory"
| fields timeframe, interval, k8s.namespace.name, dropped_rx, dropped_tx



timeseries
    received = sum(dt.kubernetes.pod.network_received_data),
    transmitted = sum(dt.kubernetes.pod.network_transmitted_data),
    by:{k8s.namespace.name, k8s.pod.name},
    from:-24h
| filter k8s.namespace.name == "app00002734-paperless-inventory"
| fields timeframe, interval, k8s.pod.name, received, transmitted



timeseries
    dropped_rx = sum(dt.kubernetes.pod.network_received_packets_dropped),
    dropped_tx = sum(dt.kubernetes.pod.network_transmitted_packets_dropped),
    by:{k8s.namespace.name},
    from:-24h
| filter k8s.namespace.name == "app00002734-paperless-inventory"
| fieldsAdd total_dropped_rx = arraySum(dropped_rx)
| fieldsAdd total_dropped_tx = arraySum(dropped_tx)
| fieldsAdd `Status` = if(total_dropped_rx > 0 or total_dropped_tx > 0, "🔴 Packet Drops Detected", else: "🟢 Clean")
| fields k8s.namespace.name, total_dropped_rx, total_dropped_tx, `Status`



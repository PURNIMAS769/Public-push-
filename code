timeseries mem = avg(dt.host.memory.usage), by:{dt.entity.host}
| fieldsAdd memAvg = arrayAvg(mem)
| lookup [ fetch dt.entity.host | fields id, tags ],
         sourceField: dt.entity.host, lookupField: id, prefix: "e."
| expand tag = e.tags
| filter startsWith(tag, "APMID:")
| fieldsAdd apmid = splitString(tag, "APMID:")[1]
| filter in(apmid, array($ClaimsApps))
| summarize maxMem        = round(max(memAvg), decimals:1),
            affectedHosts = countDistinctExact(if(memAvg >= 85, dt.entity.host)),
            totalHosts    = countDistinctExact(dt.entity.host),
            hostIds       = arrayRemoveNulls(collectDistinct(if(memAvg >= 85, dt.entity.host))),
            by:{apmid}
| filter affectedHosts > 0
| expand dt.entity.host = hostIds
| lookup [ fetch dt.entity.host | fields id, hostName = entity.name ],
         sourceField: dt.entity.host, lookupField: id, prefix: "h."
| lookup [
    timeseries mem = avg(dt.host.memory.usage), by:{dt.entity.host}
    | fieldsAdd hostMem = round(arrayAvg(mem), decimals:1)
    | fields dt.entity.host, hostMem
  ], sourceField: dt.entity.host, lookupField: dt.entity.host, prefix: "m."
| fields apmid, maxMem, affectedHosts, totalHosts, affectedHost = h.hostName, hostMem = m.hostMem, dt.entity.host
| sort maxMem desc, apmid asc, hostMem desc



timeseries availability_mode = avg(`sql-server.always-on.ar.availabilityMode`),
           failover_mode = avg(`sql-server.always-on.ar.failoverMode`),
  by:{`dt.entity.sql:sql_server_instance`}
| fieldsAdd instance_name = entityName(`dt.entity.sql:sql_server_instance`)
| parse instance_name, "LD 'via: ' LD:host_fqdn ':'"
| filter in(lower(host_fqdn), array(
    "pftwswifscq03.prd.hcscad.net",
    "pwauswifsq0101.prd.hcscad.net",
    "pwauswifscq03.prd.hcscad.net",
    "pwauswifsq0102.prd.hcscad.net",
    "pwauswifscq04.prd.hcscad.net"
  ))
| fieldsAdd avail_mode_val = arrayLast(availability_mode)
| fieldsAdd failover_mode_val = arrayLast(failover_mode)
| fields host_fqdn, avail_mode_val, failover_mode_val


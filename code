Discovery query — confirm packet errors/dropped are live for your 67 SCCM hosts
timeseries
    err_rx  = avg(dt.host.net.nic.packets.errors.rx, scalar:true),
    err_tx  = avg(dt.host.net.nic.packets.errors.tx, scalar:true),
    drop_rx = avg(dt.host.net.nic.packets.dropped.rx, scalar:true),
    drop_tx = avg(dt.host.net.nic.packets.dropped.tx, scalar:true),
  by:{dt.entity.host},
  filter: dt.entity.host in [
    fetch dt.entity.host
    | filter arrayIndexOf(tags, "APMID:APP00005497") != -1
    | fields id
  ]
| fieldsAdd hostname = entityName(dt.entity.host)
| fields hostname, err_rx, err_tx, drop_rx, drop_tx
| sort err_rx desc

SSO/OAuth Response Time by Endpoint (Table)



fetch spans, from:-2h, scanLimitGBytes: 100
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APMID:APP00006805\")"))
| filter server.address == "p-sso-sg-prd-svc.hcscint.net"
| summarize op_count = count(), avg_duration_ms = avg(duration)/1000, by:{span.name}
| sort avg_duration_ms desc


Auth Failure/Error Rate (if status codes available)
fetch spans, from:-2h, scanLimitGBytes: 100
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APMID:APP00006805\")"))
| filter server.address == "p-stv-ig-prd-svc.hcscint.net" or server.address == "p-sso-sg-prd-svc.hcscint.net"
| summarize total = count(), errors = countIf(isNotNull(error) or contains(toString(status), "error")), by:{server.address}
| fieldsAdd error_rate_pct = round((errors / total) * 100, decimals:2)




timeseries {rx  = avg(dt.host.net.nic.bytes_rx),
            tx  = avg(dt.host.net.nic.bytes_tx),
            lrx = avg(dt.host.net.nic.link_util_rx),
            ltx = avg(dt.host.net.nic.link_util_tx)},
           by:{dt.entity.host, dt.entity.network_interface}
| fieldsAdd rxMbps  = coalesce(arrayAvg(rx), 0) * 8 / 1000000,
            txMbps  = coalesce(arrayAvg(tx), 0) * 8 / 1000000,
            peakMbps = (coalesce(arrayMax(rx), 0) + coalesce(arrayMax(tx), 0)) * 8 / 1000000,
            rxUtil  = coalesce(arrayAvg(lrx), 0),
            txUtil  = coalesce(arrayAvg(ltx), 0)
| fieldsAdd totalMbps = rxMbps + txMbps,
            maxUtil   = if(rxUtil > txUtil, rxUtil, else: txUtil)
| filter totalMbps > 0
| lookup [ fetch dt.entity.host | fields id, hostName = entity.name, tags ],
         sourceField: dt.entity.host, lookupField: id, prefix: "h."
| lookup [ fetch dt.entity.network_interface | fields id, nicName = entity.name ],
         sourceField: dt.entity.network_interface, lookupField: id, prefix: "n."
| expand tag = h.tags
| filter startsWith(tag, "APMID:")
| fieldsAdd apmid = splitString(tag, "APMID:")[1]
| filter in(apmid, array($ClaimsApps))
| fieldsAdd appHostNic = concat(apmid, " | ", coalesce(h.hostName, "host n/a"), " : ",
                                coalesce(n.nicName, dt.entity.network_interface))
| fields appHostNic,
         `RX (Mbps)`   = round(rxMbps, decimals:2),
         `TX (Mbps)`   = round(txMbps, decimals:2),
         `Peak (Mbps)` = round(peakMbps, decimals:2),
         `Link util (%)` = round(maxUtil, decimals:2),
         dt.entity.host, dt.entity.network_interface
| sort `RX (Mbps)` + `TX (Mbps)` desc
| limit 15



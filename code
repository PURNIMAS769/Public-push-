C2: The same problem list, filtered to Claims

fetch dt.davis.problems, from:-30d
| sort timestamp desc
| dedup display_id
| filter dt.davis.is_duplicate == false
| expand tag = entity_tags
| filter startsWith(tag, "APMID:")
| fieldsAdd apmid = splitString(tag, "APMID:")[1]
| filter in(apmid, array($ClaimsApps))
| dedup display_id
| summarize problems = count(), apps = countDistinctExact(apmid), by:{event.name}
| sort problems desc
| limit 25



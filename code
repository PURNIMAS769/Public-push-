Container Restart Tracker (relocated from Section 3)

timeseries restarts_7d_arr = sum(dt.kubernetes.container.restarts), by:{k8s.pod.name, k8s.namespace.name, k8s.node.name}, from:-7d
| filter k8s.namespace.name == "app00006805-accums-adjudication"
| fieldsAdd restarts_7d = arraySum(restarts_7d_arr)
| join [
    timeseries restarts_24h_arr = sum(dt.kubernetes.container.restarts), by:{k8s.pod.name}, from:-24h
    | fieldsAdd restarts_24h = arraySum(restarts_24h_arr)
], kind:leftOuter, on:{left[k8s.pod.name] == right[k8s.pod.name]}, prefix:"w24."
| fieldsAdd restarts_24h = if(isNull(w24.restarts_24h), 0, else: w24.restarts_24h)
| fieldsAdd `Status` =
    if(restarts_24h >= 3, "🔴 Error (3+ restarts in 24h)",
    else: if(restarts_24h >= 1 or restarts_7d >= 1, "🟡 Restarted Recently",
    else: "🟢 Stable"))
| sort restarts_24h desc, restarts_7d desc
| fields `Node` = k8s.node.name, `Pod` = k8s.pod.name, `Restarts (7d)` = restarts_7d, `Restarts (24h)` = restarts_24h, `Status`
| limit 20


timeseries cpu = avg(dt.process.cpu.usage),
by:{dt.entity.process_group_instance},
from:-24h
timeseries memory = avg(dt.process.memory.usage),
by:{dt.entity.process_group_instance, dt.entity.host},
from:-15m
| fieldsAdd process_name = entityName(dt.entity.process_group_instance)
| filter in(dt.entity.process_group_instance, classicEntitySelector("type(process_group_instance),tag(\"APMID:APP00002734\")"))
| fieldsAdd current_memory = round(arrayLast(memory), decimals:2)
| fields process_name, current_memory, dt.entity.host
| sort current_memory desc

fetch `dt.entity.mongodb:process`
| fieldsAdd process_id = id, process_name = entity.name
| lookup [
    timeseries pages_requested = avg(mongodb.cache.pages_requested, scalar:true), by:{`dt.entity.mongodb:process`}, from:-2h
  ], sourceField:process_id, lookupField:`dt.entity.mongodb:process`, prefix:"pr_"
| lookup [
    timeseries pages_read = avg(mongodb.cache.pages_read, scalar:true), by:{`dt.entity.mongodb:process`}, from:-2h
  ], sourceField:process_id, lookupField:`dt.entity.mongodb:process`, prefix:"prd_"
| fields process_name,
    pages_requested = round(pr_pages_requested, decimals:0),
    pages_read = round(prd_pages_read, decimals:0)
| sort pages_requested desc


fetch `dt.entity.mongodb:process`
| fieldsAdd process_id = id, process_name = entity.name
| lookup [
    timeseries pages_requested = avg(mongodb.cache.pages_requested, scalar:true), by:{`dt.entity.mongodb:process`}, from:-2h
  ], sourceField:process_id, lookupField:`dt.entity.mongodb:process`, prefix:"pr_"
| lookup [
    timeseries pages_read = avg(mongodb.cache.pages_read, scalar:true), by:{`dt.entity.mongodb:process`}, from:-2h
  ], sourceField:process_id, lookupField:`dt.entity.mongodb:process`, prefix:"prd_"
| filter pr_pages_requested > 0
| fieldsAdd cache_hit_ratio_pct = round((1 - (prd_pages_read / pr_pages_requested)) * 100, decimals:2)
| fields process_name, cache_hit_ratio_pct
| sort cache_hit_ratio_pct asc

fetch dt.davis.problems, from:-30d
| sort timestamp desc
| dedup display_id
| filter event.status == "ACTIVE" and dt.davis.is_duplicate == false
| filter event.name == "Deployment stuck" or event.name == "No pod ready"
| expand tag = entity_tags
| filter startsWith(tag, "APMID:")
| fieldsAdd apmid = splitString(tag, "APMID:")[1]
| filter in(apmid, array($ClaimsApps))
| dedup display_id
| expand dt.entity.cloud_application = affected_entity_ids
| filter startsWith(dt.entity.cloud_application, "CLOUD_APPLICATION-")
| lookup [ fetch dt.entity.cloud_application | fields id, wName = entity.name ],
         sourceField: dt.entity.cloud_application, lookupField: id, prefix: "w."
| fieldsAdd status      = "🔴 Critical",
            appWorkload = concat(apmid, " | ", coalesce(w.wName, dt.entity.cloud_application)),
            openFor     = now() - event.start
| fields status, appWorkload, event.name, display_id, openFor, dt.entity.cloud_application
| sort openFor desc



T3: Link utilization on Claims interfaces

timeseries {rx = avg(dt.host.net.nic.link_util_rx),
            tx = avg(dt.host.net.nic.link_util_tx)},
           by:{dt.entity.host, dt.entity.network_interface}, from:-2h
| fieldsAdd util = max(coalesce(arrayAvg(rx), 0), coalesce(arrayAvg(tx), 0))
| lookup [ fetch dt.entity.host | fields id, tags ],
         sourceField: dt.entity.host, lookupField: id, prefix: "h."
| expand tag = h.tags
| filter startsWith(tag, "APMID:")
| fieldsAdd apmid = splitString(tag, "APMID:")[1]
| filter in(apmid, array($ClaimsApps))
| dedup dt.entity.network_interface
| summarize interfaces = count(),
            `util >= 50` = countIf(util >= 50),
            `util >= 70` = countIf(util >= 70),
            `util >= 90` = countIf(util >= 90),
            maxUtil = round(max(util), decimals:2)



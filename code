fetch dt.entity.kubernetes_node
| fields id,                                   // KEEP node entity id as `id` -> this is what "Open with" acts on
         node_name  = entity.name,
         cluster_id = clustered_by[dt.entity.kubernetes_cluster]   // stays cluster-typed -> cluster actions preserved
| fieldsAdd node_entity_id = id                // copy for the problems lookup below
| lookup [
    fetch dt.entity.kubernetes_cluster
    | fields cluster_entity_id = id, cluster_name = entity.name
  ],
  sourceField: cluster_id, lookupField: cluster_entity_id,
  fields: {cluster_name}                       // do NOT bring the cluster's id back in as `id`
| lookup [
    timeseries
      { ready = sum(dt.kubernetes.node.conditions, scalar: true,
                    filter: {node_condition == "Ready" and condition_status == true}, default: 0),
        bad_conditions = sum(dt.kubernetes.node.conditions, scalar: true,
                    filter: {node_condition != "Ready" and condition_status == true}, default: 0) },
      by: {k8s.node.name, k8s.cluster.name, dt.entity.kubernetes_node}, from: -1h, to: -2m
    | fieldsAdd condition_status = if(ready == 0 or bad_conditions > 0, "Unhealthy", else: "Healthy")
  ],
  sourceField: node_name, lookupField: k8s.node.name,
  fields: {condition_status}
| lookup [
    fetch dt.davis.problems, from: -24h
    | filter not(dt.davis.is_duplicate) and event.status == "ACTIVE"
    | filter matchesValue(affected_entity_types, "dt.entity.kubernetes_node")
    | expand affected_entity_ids
    | fields affected_entity_ids, display_id
  ],
  sourceField: node_entity_id, lookupField: affected_entity_ids,
  fields: {display_id}
| fieldsAdd status = if(condition_status == "Unhealthy" or isNotNull(display_id),
                        "Unhealthy", else: "Healthy")
| filter arraySize(array($Cluster)) == 0 or in(cluster_name, array($Cluster))
| sort status desc

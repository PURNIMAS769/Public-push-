fetch dt.davis.events, from:-90d
| filter contains(event.name, "stuck in pending")
    or contains(event.name, "stuck in terminating")
    or contains(event.name, "without ready pods")
    or contains(event.name, "non-ready pods")
    or contains(event.name, "backoff")
    or contains(event.name, "eviction")
    or contains(event.name, "preemption")
| summarize count(), by:{event.name}
| sort count() desc
| limit 20

with ID columns are the same as in 6.1 and 6.2.

timeseries {age   = max(ibmmq.queue.oldest_message, scalar: true),
            depth = max(ibmmq.queue.depth, scalar: true)},
           by:{queue_manager, queue_name}, from:-30m
| filter isNotNull(age) and age >= 300 and coalesce(depth, 0) > 0
// app -> queue (from MQ alert history)
| lookup [
    fetch dt.davis.problems, from:-90d
    | sort timestamp desc
    | dedup display_id
    | filter contains(event.name, "IBMMQ_APP")
    | fieldsAdd apmid = concat("APP", substring(splitString(event.name, "IBMMQ_APP")[1], from:0, to:8))
    | filter in(apmid, array($ClaimsApps))
    | expand eid = affected_entity_ids
    | lookup [ fetch `dt.entity.ibmmq:local_queue` | fields id, qName = entity.name ],
             sourceField: eid, lookupField: id, prefix: "lq."
    | filter isNotNull(lq.qName)
    | summarize apps = collectDistinct(apmid), by:{queueName = lq.qName}
  ], sourceField: queue_name, lookupField: queueName, prefix: "m."
| filter isNotNull(m.apps)
| expand apmid = m.apps
// MQ server name and host ID
| lookup [
    timeseries a = avg(ibmmq.queue_manager.availability),
               by:{queue_manager, host.name, dt.entity.host}, from:-30m
    | summarize server = takeFirst(host.name),
                hostId = takeFirst(dt.entity.host),
                by:{queue_manager}
  ], sourceField: queue_manager, lookupField: queue_manager, prefix: "a."
// entity IDs for Open with
| lookup [
    fetch `dt.entity.ibmmq:queue_manager`
    | fields qmEntityId = id, qmEntityName = entity.name
  ], sourceField: queue_manager, lookupField: qmEntityName, prefix: "e."
| lookup [
    fetch `dt.entity.ibmmq:local_queue`
    | fields lqId = id, lqName = entity.name
  ], sourceField: queue_name, lookupField: lqName, prefix: "l."
| fieldsAdd ageMin = round(age / 60, decimals:1),
            status = if(age >= 1800, "🔴 Critical", else: "🟠 Warning"),
            rank   = if(age >= 1800, 1, else: 2)
| fieldsAdd appQmQueue = concat(apmid, " | ", coalesce(a.server, "host n/a"), " : ", queue_manager, " / ", queue_name)
| fields status, appQmQueue, ageMin, depth = round(depth, decimals:0),
         `dt.entity.ibmmq:queue_manager` = e.qmEntityId,
         `dt.entity.ibmmq:local_queue`   = l.lqId,
         dt.entity.host = a.hostId,
         rank
| sort rank asc, ageMin desc
| fieldsRemove rank

timeseries avg(dt.process.zos.db2.num_active_connections), by:{dt.entity.process_group}
| fieldsAdd pgName = entityName(dt.entity.process_group)
| filter contains(pgName, "DP0C") or contains(pgName, "DB2")


fetch dt.entity.process_group
| filter contains(entity.name, "DP0C") or contains(toString(tags), "DB2")
| fieldsAdd entity.name, id, tags

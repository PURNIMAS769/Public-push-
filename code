fetch dt.entity.kubernetes_node
| fields node_entity_id = id, node_name = entity.name /* + cluster relationship */
// LEFT lookup the timeseries ready/bad_conditions  -> condition_status
// LEFT lookup dt.davis.problems (ACTIVE, non-duplicate) -> display_id
| fieldsAdd status = if(condition_status == "Unhealthy" or isNotNull(display_id), "Unhealthy", else: "Healthy")
| filter arraySize(array($Cluster)) == 0 or in(cluster_name, array($Cluster))
| sort status desc

Host-level Page Faults — SMSEXEC (hosts running smsexec.exe)
timeseries page_faults = avg(dt.host.memory.avail.pfps, scalar:true),
  by:{dt.entity.host},
  filter: dt.entity.host in [
    fetch dt.entity.process_group_instance
    | filter contains(entity.name, "smsexec.exe")
    | fieldsAdd h = runs_on[dt.entity.host]
    | fields h
  ]
| fieldsAdd hostname = entityName(dt.entity.host)
| fields hostname, page_faults
| sort page_faults desc


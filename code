timeseries requests = sum(dt.service.request.count),
by:{dt.entity.service}
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APPName:Blue_Chip_Benefit_Determination_Prod\")"))
| fieldsAdd service_name = entityName(dt.entity.service)
| fieldsAdd total_requests = arraySum(requests)
| filter total_requests > 0
| fields timeframe, interval, service_name, requests, dt.entity.service

timeseries p95_response = percentile(dt.service.request.response_time, 95),
by:{dt.entity.service}
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APPName:Blue_Chip_Benefit_Determination_Prod\")"))
| fieldsAdd service_name = entityName(dt.entity.service)
| fieldsAdd total_check = arraySum(p95_response)
| filter isNotNull(total_check) and total_check > 0
| fields timeframe, interval, service_name, p95_response, dt.entity.service


timeseries
    total_requests = sum(dt.service.request.count),
    failed_requests = sum(dt.service.request.failure_count),
    by:{dt.entity.service},
    from:-24h
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APPName:Blue_Chip_Benefit_Determination_Prod\")"))
| fieldsAdd service_name = entityName(dt.entity.service)
| fieldsAdd total_sum = arraySum(total_requests), failed_sum = arraySum(failed_requests)
| filter total_sum > 0
| fieldsAdd failure_rate_pct = round((failed_sum / total_sum) * 100, decimals:2)
| filter failure_rate_pct > 0
| fields service_name, dt.entity.service, total_sum, failed_sum, failure_rate_pct
| sort failure_rate_pct desc


timeseries
    total_mem = avg(dt.runtime.jvm.memory.total),
    free_mem = avg(dt.runtime.jvm.memory.free),
    max_mem = avg(dt.runtime.jvm.memory.max),
    by:{dt.entity.process_group_instance},
    from:-24h
| filter in(dt.entity.process_group_instance,
    classicEntitySelector("type(process_group_instance),tag(\"APPName:Blue_Chip_Benefit_Determination_Prod\")"))
| fieldsAdd process_name = entityName(dt.entity.process_group_instance)
| fieldsAdd used_mem = subtract(total_mem, free_mem)
| fieldsAdd heap_used_pct = arrayDiv(arrayMultiply(used_mem, 100), max_mem)
| fields process_name, heap_used_pct, dt.entity.process_group_instance


timeseries
    pool_used = avg(dt.runtime.jvm.memory.pool.used),
    pool_max = avg(dt.runtime.jvm.memory.pool.max),
    by:{dt.entity.process_group_instance},
    from:-24h
| filter in(dt.entity.process_group_instance,
    classicEntitySelector("type(process_group_instance),tag(\"APPName:Blue_Chip_Benefit_Determination_Prod\")"))
| fieldsAdd process_name = entityName(dt.entity.process_group_instance)
| fieldsAdd current_used_mb = round(arrayLast(pool_used) / 1024 / 1024, decimals:2)
| fieldsAdd current_max_mb = round(arrayLast(pool_max) / 1024 / 1024, decimals:2)
| fields process_name, current_used_mb, current_max_mb, dt.entity.process_group_instance
| sort current_used_mb desc

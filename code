1.6 Problem trend, per hour for 24 hours (stacked area or line)

fetch dt.davis.problems, from:-24h
| sort timestamp desc
| dedup display_id
| filter dt.davis.is_duplicate == false
| expand tag = entity_tags
| filter startsWith(tag, "APMID:")
| fieldsAdd apmid = splitString(tag, "APMID:")[1]
| filter in(apmid, array($MembershipApps))
| dedup display_id
| fieldsAdd impact = arrayToString(dt.davis.impact_level, delimiter:", ")
| makeTimeseries problems = count(), by:{impact},
                 time:event.start, interval:1h,
                 from:now()-24h, to:now(), nonempty:true



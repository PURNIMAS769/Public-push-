timeseries sum(dt.service.database.query.count), by:{dt.entity.service}
| fieldsAdd serviceName = entityName(dt.entity.service)
| filter contains(serviceName, "accums") or contains(serviceName, "dme") 
or contains(serviceName, "DP0C") or contains(serviceName, "ServiceLevel") or
contains(serviceName, "Scenario") or contains(serviceName, "Shared")

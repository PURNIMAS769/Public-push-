Step 2: Final tile 3.6
timeseries uptime = avg(dt.host.uptime, scalar: true), by:{dt.entity.host}, from:-30m
| filter uptime < 86400
| fieldsAdd uptimeHrs = round(uptime / 3600, decimals:1)
| lookup [ fetch dt.entity.host | fields id, hostName = entity.name, tags ],
         sourceField: dt.entity.host, lookupField: id, prefix: "h."
| expand tag = h.tags
| filter startsWith(tag, "APMID:")
| fieldsAdd apmid = splitString(tag, "APMID:")[1]
| filter in(apmid, array($ClaimsApps))
| fieldsAdd appHost = concat(apmid, " | ", h.hostName)
| fields appHost, uptimeHrs, dt.entity.host
| sort uptimeHrs asc

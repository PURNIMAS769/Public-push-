fetch dt.davis.problems, from:-30d
| filter not(dt.davis.is_duplicate)
| filter in("APPName:Blue_Chip_Benefit_Determination_Prod", entity_tags)
| fieldsAdd `Entity Type` =
    if(contains(toString(affected_entity_types), "dt.entity.host"), "Host/Node",
    else: if(contains(toString(affected_entity_types), "dt.entity.process_group_instance"), "Process/Instance",
    else: if(contains(toString(affected_entity_types), "dt.entity.service"), "Service",
    else: if(contains(toString(affected_entity_types), "dt.entity.network_interface"), "Network",
    else: if(contains(toString(affected_entity_types), "dt.entity.disk"), "Disk",
    else: if(contains(toString(affected_entity_types), "dt.entity.custom_device"), "Custom Device (DB2/Mainframe)",
    else: "Other"))))))
| summarize problem_count = countDistinct(display_id), by:{ day = bin(event.start, 1d), `Entity Type` }
| sort day desc

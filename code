Fix — make APMID a required condition inside a Claims-scoped set:

fetch dt.entity.service
| fields id, entity.name, tags, tagStr = toString(tags)
| filter contains(lower(tagStr), "claim")
| expand tags
| filter contains(tags, "APP000") or contains(tags, "APP002")
| fieldsAdd apmid = if(contains(tags, "APMID:"), splitString(tags, "APMID:")[1],
                    else: if(contains(tags, "APPID:"), splitString(tags, "APPID:")[1],
                    else: tags))
| filter startsWith(apmid, "APP")
| summarize services = countDistinctExact(id), by:{apmid}
| sort services desc

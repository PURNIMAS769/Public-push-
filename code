fetch dt.davis.problems, from:-60d
| filter not(dt.davis.is_duplicate)
| expand affected_entity_ids

// Scope to SCCM-related entities (same validated pattern as Host/Process/Alert Analysis tiles)
| lookup [
    fetch dt.entity.host
    | filter arrayIndexOf(tags, "APMID:APP00005497") != -1
    | fields id
  ], sourceField:affected_entity_ids, lookupField:id, prefix:"host_"

| lookup [
    fetch dt.entity.process_group_instance
    | fieldsAdd h = runs_on[dt.entity.host]
    | lookup [
        fetch dt.entity.host
        | filter arrayIndexOf(tags, "APMID:APP00005497") != -1
        | fields id
      ], sourceField:h, lookupField:id, prefix:"hh_"
    | filter isNotNull(hh_id)
    | fields id
  ], sourceField:affected_entity_ids, lookupField:id, prefix:"proc_"

| lookup [
    fetch `dt.entity.os:service`
    | fieldsAdd h = runs_on[dt.entity.host]
    | lookup [
        fetch dt.entity.host
        | filter arrayIndexOf(tags, "APMID:APP00005497") != -1
        | fields id
      ], sourceField:h, lookupField:id, prefix:"svch_"
    | filter isNotNull(svch_id)
    | fields id
  ], sourceField:affected_entity_ids, lookupField:id, prefix:"svc_"

| fieldsAdd entity_kind = if(isNotNull(host_id), "Host",
                          else: if(isNotNull(svc_id), "Service",
                          else: if(isNotNull(proc_id), "Process", else: null)))

| filter isNotNull(entity_kind)

| makeTimeseries alerts = countDistinct(event.id), by:{entity_kind, event.category}

fetch dt.davis.problems, from:-30d
| filter not(dt.davis.is_duplicate)
| dedup {event.id}, sort:{timestamp desc}
| filter event.status == "ACTIVE"
| expand affected_entity_ids
// --- keep only problems on our MIs (classic + Gen3 ids) ---
| lookup [
    timeseries c = avg(cloud.azure.microsoft_sql.managedinstances.avg_cpu_percent),
               by:{dt.entity.custom_device},
               filter:{isNotNull(dt.entity.custom_device)},
               from:-24h, to:now()
    | fields id = toString(dt.entity.custom_device),
             mi_name = entityName(dt.entity.custom_device)
    | append [
        timeseries a = avg(cloud.azure.microsoft_sql.managedinstances.avg_cpu_percent),
                   by:{dt.smartscape_source.id, azure.resource.name},
                   filter:{dt.da.source == "azure-metric-poller"},
                   from:-24h, to:now()
        | fields id = toString(dt.smartscape_source.id),
                 mi_name = azure.resource.name
      ]
  ], sourceField:affected_entity_ids, lookupField:id, fields:{mi_name}
| filter isNotNull(mi_name)
// --- count each active problem once ---
| dedup {event.id}
| summarize Active_Alerts = count(), by:{Severity = event.category}
| sort Active_Alerts desc

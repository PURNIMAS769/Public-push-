timeseries requests = sum(dt.service.request.count),
    by:{dt.entity.service}
    //,from:-24h
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APMID:APP00006805\")"))
| fieldsAdd service_name = entityName(dt.entity.service)
| fieldsAdd total_requests = arraySum(requests)
| filter total_requests > 0
| fields timeframe, interval, service_name, requests, dt.entity.service

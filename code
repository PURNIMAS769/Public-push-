fetch `dt.entity.mongodb:process`
| fieldsAdd process_id = id, process_name = entity.name
| lookup [
    timeseries virtual_mem = avg(mongodb.virtual_memory, scalar:true), by:{`dt.entity.mongodb:process`}, from:-2h
  ], sourceField:process_id, lookupField:`dt.entity.mongodb:process`, prefix:"m_"
| fields process_name, virtual_memory_mb = round(m_virtual_mem, decimals:0)

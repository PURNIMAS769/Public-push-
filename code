Disk Utilization % (Top 50)

timeseries disk_used_pct = avg(dt.host.disk.used.percent, scalar:true), by:{dt.entity.host, dt.entity.disk}
| fieldsAdd instance = entityName(dt.entity.host)
| lookup [
    fetch `dt.entity.sql:db2_host`
    | fields db2_hostname = Hostname, real_hostname = Hostname
  ], sourceField:instance, lookupField:real_hostname, prefix:""
| filter isNotNull(db2_hostname)
| fieldsAdd disk_name = entityName(dt.entity.disk)
| fields instance, disk_name, disk_used_pct
| sort disk_used_pct desc
| limit 50


Disk Free vs Used

timeseries {
    used = avg(dt.host.disk.used, scalar:true),
    avail = avg(dt.host.disk.avail, scalar:true)
}, by:{dt.entity.host, dt.entity.disk}
| fieldsAdd instance = entityName(dt.entity.host)
| lookup [
    fetch `dt.entity.sql:db2_host`

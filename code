M3: Which apps sit under each portfolio, on namespaces

fetch dt.entity.cloud_application_namespace
| fields id, name = entity.name, tags
| expand tag = tags
| summarize portfolio = arrayRemoveNulls(collectDistinct(if(startsWith(tag, "Portfolio:"), tag))),
            apmid     = arrayRemoveNulls(collectDistinct(if(startsWith(tag, "APMID:"), splitString(tag, "APMID:")[1]))),
            by:{id, name}
| expand p = portfolio
| filter contains(lower(p), "commercial") or contains(lower(p), "member")
| expand a = apmid
| summarize namespaces = countDistinctExact(id), sampleName = takeFirst(name), by:{p, a}
| sort p asc, namespaces desc


M4: The same on hosts

fetch dt.entity.host
| fields id, tags
| expand tag = tags
| summarize portfolio = arrayRemoveNulls(collectDistinct(if(contains(lower(tag), "portfolio:"), tag))),
            apmid     = arrayRemoveNulls(collectDistinct(if(startsWith(tag, "APMID:"), splitString(tag, "APMID:")[1]))),
            by:{id}
| expand p = portfolio
| filter contains(lower(p), "commercial_markets") or contains(lower(p), "commercial markets")
      or contains(lower(p), "member")
| expand a = apmid
| summarize hosts = countDistinctExact(id), by:{p, a}
| sort p asc, hosts desc


M5: Which portfolio the Member apps carry

fetch dt.entity.host
| fields id, tags
| expand tag = tags
| summarize portfolio = arrayRemoveNulls(collectDistinct(if(contains(lower(tag), "portfolio:"), tag))),
            memberApp = arrayRemoveNulls(collectDistinct(if(startsWith(tag, "APPName:") and contains(lower(tag), "member"), tag))),
            by:{id}
| filter arraySize(memberApp) > 0
| fieldsAdd p = if(arraySize(portfolio) == 0, array("(no portfolio tag)"), else: portfolio)
| expand p
| summarize hosts = countDistinctExact(id), by:{p}
| sort hosts desc

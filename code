timeseries {lag = avg(postgres.replication.replay_lag), delay = avg(postgres.replication.replay_delay)},
           by:{device.name, client_hostname, state, sync_state}, from:-2h, interval:5m
| fieldsAdd lagNow       = arrayLast(arrayRemoveNulls(lag)),
            delayMB      = round(arrayLast(arrayRemoveNulls(delay)) / 1048576, decimals:1),
            hostShort    = lower(splitString(device.name, ".")[0]),
            notStreaming = state != "streaming"
| lookup [
    fetch dt.entity.host
    | fields hostName = entity.name, tags
    | expand t = tags
    | filter startsWith(t, "APMID:")
    | fieldsAdd apmid = splitString(t, "APMID:")[1],
                hostShort = lower(splitString(hostName, ".")[0])
    | filter in(apmid, array($ClaimsApps))
    | summarize claimsApps = collectDistinct(apmid), by:{hostShort}
  ], sourceField: hostShort, lookupField: hostShort, prefix: "h."
| filter isNotNull(h.claimsApps)
| expand apmid = h.claimsApps
| fieldsAdd status = if(notStreaming or coalesce(lagNow, 0) > 300, "🔴 Critical",
                     else: if(coalesce(lagNow, 0) > 30, "🟠 Warning", else: "🟢 Healthy")),
            rank   = if(notStreaming or coalesce(lagNow, 0) > 300, 1,
                     else: if(coalesce(lagNow, 0) > 30, 2, else: 3))
| fieldsAdd appLink = concat(apmid, " | ", device.name, " → ", client_hostname)
| fields status, appLink, state, sync_state, lagSec = round(lagNow, decimals:2), delayMB, rank
| sort rank asc, lagSec desc
| fieldsRemove rank



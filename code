xist for SCCM hosts
fetch logs, from:-24h
| filter contains(log.source, "Application") or contains(dt.system.bucket, "windows")
| filter contains(content, "MsiInstaller") or contains(content, "1033") or contains(content, "1034")
| lookup [
    fetch dt.entity.host
    | filter arrayIndexOf(tags, "APMID:APP00005497") != -1
    | fields id
  ], sourceField:dt.entity.host, lookupField:id, prefix:"hh_"
| filter isNotNull(hh_id)
| fields content, log.source, timestamp
| limit 20

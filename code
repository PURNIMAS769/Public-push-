timeseries lock_wait = sum(db2.lock_wait_time.count), by:{`dt.entity.sql:db2_instance`}, from:-2h
| fieldsAdd total_lock_wait_sec = round(arraysum(lock_wait) / 1000, decimals:2)
| fieldsAdd instance = entityName(`dt.entity.sql:db2_instance`)
| filter isNotNull(instance)
| fields instance, `Lock Wait (sec)` = total_lock_wait_sec
| sort `Lock Wait (sec)` desc
| limit 20

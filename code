Resident Memory (MB)
fetch `dt.entity.mongodb:process`
| fieldsAdd process_id = id, process_name = entity.name
| lookup [
    timeseries resident_mem = avg(mongodb.resident_memory), by:{`dt.entity.mongodb:process`}, from:-2h
  ], sourceField:process_id, lookupField:`dt.entity.mongodb:process`, prefix:"m_"
| fieldsAdd interval = m_interval, timeframe = m_timeframe
| fields process_name, resident_memory_mb = m_resident_mem, timeframe, interval



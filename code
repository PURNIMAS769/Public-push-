// Check 1: Does dt.host.availability.state exist and what values does it report for your MongoDB hosts?
fetch metric.series
| filter contains(metric.key, "availability")
| summarize count(), by:{metric.key}


// Check 2: Do any SERVICE entities exist running on your MongoDB hosts at all?
fetch dt.entity.host
| filter in(entity.name, array("<one of your mongo host names>"))
| fieldsAdd services = runs[dt.entity.service]
| fields entity.name, services

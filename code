fetch dt.davis.events, from:-30d
| expand affected_entity_ids
| lookup [
    fetch dt.entity.host
    | filter arrayIndexOf(tags, "APPName:Blue_Chip_Benefit_Determination_Prod") > -1
    | fields id, entity.name
  ], sourceField: affected_entity_ids, lookupField: id, fields: { host_name = entity.name }
| lookup [
    fetch dt.entity.process_group_instance
    | filter arrayIndexOf(tags, "APPName:Blue_Chip_Benefit_Determination_Prod") > -1
    | fields id, entity.name
  ], sourceField: affected_entity_ids, lookupField: id, fields: { pgi_name = entity.name }
| lookup [
    fetch dt.entity.service
    | filter arrayIndexOf(tags, "APPName:Blue_Chip_Benefit_Determination_Prod") > -1
    | fields id, entity.name
  ], sourceField: affected_entity_ids, lookupField: id, fields: { service_name = entity.name }
| filter isNotNull(host_name) or isNotNull(pgi_name) or isNotNull(service_name)
| fieldsAdd matched_entity = if(isNotNull(host_name), host_name, else: if(isNotNull(pgi_name), pgi_name, else: service_name))
| fieldsAdd entity_layer = if(isNotNull(host_name), "Host", else: if(isNotNull(pgi_name), "Process", else: "Service"))
| summarize count(), by:{event.type, event.name, entity_layer}
| sort entity_layer asc

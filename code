fetch dt.entity.process_group_instance
| filter arrayIndexOf(tags, "APPName:Blue_Chip_Benefit_Determination_Prod") > -1
| fieldsAdd host = runs_on[dt.entity.host]
| fieldsAdd all_ids = arrayConcat(array(id), host)
| fieldsKeep all_ids
| expand check_id = all_ids
| append [
    fetch dt.entity.service
    | filter arrayIndexOf(tags, "APPName:Blue_Chip_Benefit_Determination_Prod") > -1
    | fields check_id = id
]
| join [
    fetch dt.davis.problems
    | filter not(dt.davis.is_duplicate) and event.category == "AVAILABILITY"
    | expand affected_entity_ids
    | fieldsAdd clamped_start = if(event.start < toTimestamp($dt_timeframe_from),
        toTimestamp($dt_timeframe_from), else: event.start)
    | fieldsAdd clamped_end = if(isNotNull(event.end), if(event.end > toTimestamp($dt_timeframe_to),
        toTimestamp($dt_timeframe_to), else: event.end), else: toTimestamp($dt_timeframe_to))
    | fieldsAdd downtime_ms = (clamped_end - clamped_start) / 1ms
    | summarize downtime_ms = takeFirst(downtime_ms), by:{affected_entity_ids, display_id}
], kind:leftOuter, on:{left[check_id] == right[affected_entity_ids]}, prefix:"p."
| summarize total_downtime_ms = sum(p.downtime_ms)
| fieldsAdd total_downtime_ms = if(isNull(total_downtime_ms), 0, else: total_downtime_ms)
| fieldsAdd Downtime_Used = round(total_downtime_ms / 3600000, decimals:2)
| fieldsAdd target = 99.9
| fieldsAdd total_period_hrs = (toTimestamp($dt_timeframe_to) - toTimestamp($dt_timeframe_from)) / 1h
| fieldsAdd Allowed_Downtime = round(((100 - target) / 100) * total_period_hrs, decimals:2)
| fieldsAdd Remaining_Budget = round(Allowed_Downtime - Downtime_Used, decimals:2)
| fields Downtime_Used, Allowed_Downtime, Remaining_Budget

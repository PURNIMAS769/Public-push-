fetch dt.entity.custom_device
| filter contains(entity.name, "DP0C") or contains(entity.name, "DB2") or contains(entity.name, "Mainframe")
| fieldsAdd entity.name, id, tags

fetch metric.series
| filter contains(metric.key, "db2") or contains(metric.key, "mainframe")
| summarize count(), by:{metric.key}

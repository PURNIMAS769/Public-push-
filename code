fetch dt.entity.service
| filter contains(entity.name, "stv-ig") or contains(entity.name, "sso-sg") or contains(entity.name, "hcscint")
| fieldsAdd entity.name, id, tags


fetch dt.entity.custom_device
| filter contains(entity.name, "stv-ig") or contains(entity.name, "sso-sg")
| fieldsAdd entity.name, id, tags


fetch spans
| filter server.address == "p-sso-sg-prd-svc.hcscint.net" or server.address == "p-stv-ig-prd-svc.hcscint.net"
| summarize count(), avgDuration = avg(duration), by:{server.address, span.name}

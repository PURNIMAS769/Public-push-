timeseries
    total_pods = sum(dt.kubernetes.pods),
    running_pods = sum(dt.kubernetes.pods, filter: pod_phase == "Running"),
    by:{k8s.namespace.name},
    from:-15m
| filter k8s.namespace.name == "app00002734-paperless-inventory"
| fieldsAdd current_total = arrayLast(total_pods), current_running = arrayLast(running_pods)
| fields k8s.namespace.name, current_total, current_running

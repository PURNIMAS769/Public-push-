his tells us where to set the threshold, so the tile doesn't end up empty or full of noise.

timeseries gc = avg(dt.runtime.jvm.gc.suspension_time, scalar: true),
           by:{dt.entity.process_group_instance}, from:-2h
| lookup [
    fetch dt.entity.process_group_instance
    | fields id, tags
    | expand tag = tags
    | filter startsWith(tag, "APMID:")
    | summarize apmids = collectDistinct(splitString(tag, "APMID:")[1]), by:{id}
    | filter arraySize(apmids) == 1
    | fieldsAdd apmid = apmids[0]
  ], sourceField: dt.entity.process_group_instance, lookupField: id, prefix: "p."
| filter in(p.apmid, array($ClaimsApps))
| summarize jvms = count(),
            `gc >= 1`  = countIf(gc >= 1),
            `gc >= 5`  = countIf(gc >= 5),
            `gc >= 10` = countIf(gc >= 10)

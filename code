timeseries used_pct = avg(dt.host.memory.usage, scalar:true),
used = avg(dt.host.memory.used, scalar:true),
recl = avg(dt.host.memory.recl, scalar:true),
swap_used = avg(dt.host.memory.swap.used, scalar:true),
swap_total = avg(dt.host.memory.swap.total, scalar:true),
page_faults = avg(dt.host.memory.avail.pfps, scalar:true),
iowait = avg(dt.host.cpu.iowait, scalar:true),
by: { dt.entity.host },
filter: { in(entityAttr(dt.entity.host, "osType"), array("LINUX")) and in(dt.entity.host, $Host) },
from:-7d, interval:1h
| fieldsAdd host.name = entityName(dt.entity.host)
| fieldsAdd active_memory_gb = used / 1024 / 1024 / 1024
| fieldsAdd total_memory_footprint_gb = (used + recl) / 1024 / 1024 / 1024
| fieldsAdd reusable_cache_gb = recl / 1024 / 1024 / 1024
| fieldsAdd swap_used_gb = swap_used / 1024 / 1024 / 1024
| fieldsAdd swap_pct = if(swap_total > 0, (swap_used / swap_total) * 100, else:0)
| fieldsAdd health_status = if(used_pct > 80 and page_faults > 20, "OVERLOADED (Usage+PageFaults)",
else:if(swap_pct > 10 and iowait > 5, "OVERLOADED (Swap+IOWait)",
else:"HEALTHY"))
| fieldsAdd used_pct_rounded = round(used_pct, decimals:1)
| fieldsAdd page_faults_rounded = round(page_faults, decimals:2)
| fieldsAdd swap_pct_rounded = round(swap_pct, decimals:1)
| fieldsAdd iowait_rounded = round(iowait, decimals:1)
| fields `Host Name` = host.name,
`Active Memory In Use (GB)` = active_memory_gb,
`Memory Usage %` = used_pct_rounded,
`Total Memory Footprint incl. Cache (GB)` = total_memory_footprint_gb,
`Reusable Cache Reclaimable (GB)` = reusable_cache_gb,
`Disk Swap In Use (GB)` = swap_used_gb,
`Swap Used %` = swap_pct_rounded,
`CPU I/O Wait %` = iowait_rounded,
`Memory Fetch Delays (Page Faults/sec)` = page_faults_rounded,
`Overall Health` = health_status
| sort `Memory Usage %` desc
| limit 25

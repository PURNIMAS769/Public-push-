1.2 Monitoring coverage quality (donut)

data record(apmid = array($MembershipApps))
| expand apmid
| lookup [
    fetch dt.entity.host
    | fields id, tags
    | expand tag = tags
    | filter startsWith(tag, "APMID:")
    | fieldsAdd apmid = splitString(tag, "APMID:")[1]
    | summarize hosts = countDistinctExact(id), by:{apmid}
  ], sourceField: apmid, lookupField: apmid, prefix: "h."
| lookup [
    fetch dt.entity.service
    | fields id, tags
    | expand tag = tags
    | filter startsWith(tag, "APMID:")
    | summarize apmids = collectDistinct(splitString(tag, "APMID:")[1]), by:{id}
    | filter arraySize(apmids) == 1
    | fieldsAdd apmid = apmids[0]
    | summarize services = count(), by:{apmid}
  ], sourceField: apmid, lookupField: apmid, prefix: "s."
| fieldsAdd hosts = coalesce(h.hosts, 0), services = coalesce(s.services, 0)
| fieldsAdd coverage = if(services >= 5, "Full stack",
                       else: if(services > 0, "Thin (1-4 services)",
                       else: "Hosts / namespaces only"))
| summarize apps = count(), by:{coverage}


Expected result: 5, 9 and 3, which add up to 17.

1.3 Hosts: Commercial Markets-only vs shared (bar)

fetch dt.entity.host
| fields id, tags
| expand tag = tags
| fieldsAdd lt = lower(replaceString(tag, "_", " "))
| summarize cmVals    = countDistinctExact(if(contains(lt, "portfolio:commercial markets"), tag)),
            otherVals = countDistinctExact(if(contains(lt, "portfolio:") and not(contains(lt, "portfolio:commercial markets")), tag)),
            apmids    = collectDistinct(if(startsWith(tag, "APMID:"), splitString(tag, "APMID:")[1])),
            by:{id}
| expand apmid = apmids
| filter in(apmid, array($MembershipApps))
| dedup id
| fieldsAdd hostType = if(cmVals > 0 and otherVals == 0, "Commercial Markets-only",
                       else: if(cmVals > 0, "Shared with other portfolios",
                       else: "Other portfolio / no portfolio tag"))
| summarize hosts = count(), by:{hostType}


1.4 Active problems (single value)

fetch dt.davis.problems, from:-30d
| sort timestamp desc
| dedup display_id
| filter event.status == "ACTIVE" and dt.davis.is_duplicate == false
| expand tag = entity_tags
| filter startsWith(tag, "APMID:")
| fieldsAdd apmid = splitString(tag, "APMID:")[1]
| filter in(apmid, array($MembershipApps))
| summarize activeProblems = countDistinctExact(display_id)



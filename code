data record(queue_manager = "HCSC1P"),
     record(queue_manager = "MULEPRD1"),
     record(queue_manager = "MULEPRD3")
| lookup [
    fetch dt.davis.problems, from:-30d
    | sort timestamp desc
    | summarize event.status = takeFirst(event.status),
                event.name = takeFirst(event.name),
                event.category = takeFirst(event.category),
                affected_entity_ids = takeFirst(affected_entity_ids),
                by:{display_id}
    | filter event.status == "ACTIVE"
    | filter event.category == "AVAILABILITY"
    | filter contains(event.name, "Queue_Manager is unavailable")
    | expand affected_entity_ids
    | fieldsAdd queue_manager = entityName(affected_entity_ids, "dt.entity.ibmmq:queue_manager")
    | summarize active_unavail = count(), by:{queue_manager}
  ], sourceField:queue_manager, lookupField:queue_manager, fields:{active_unavail}
| lookup [
    timeseries avail = avg(ibmmq.queue_manager.availability, scalar:true),
      by:{`dt.entity.ibmmq:queue_manager`}, from:-15m
    | fieldsAdd queue_manager = entityName(`dt.entity.ibmmq:queue_manager`)
    | fields queue_manager, avail
  ], sourceField:queue_manager, lookupField:queue_manager, fields:{avail}
| fieldsAdd active_unavail = coalesce(active_unavail, 0)
| fieldsAdd qm_down = active_unavail > 0 or (isNotNull(avail) and avail < 100)
| summarize hcsc_down = countIf(queue_manager == "HCSC1P" and qm_down),
            m1_down = countIf(queue_manager == "MULEPRD1" and qm_down),
            m3_down = countIf(queue_manager == "MULEPRD3" and qm_down)
| fieldsAdd status = if(hcsc_down > 0 or (m1_down > 0 and m3_down > 0), "RED",
                     else: if(m1_down > 0 or m3_down > 0, "AMBER", else: "GREEN"))
| fields status

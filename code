data record(apmid = array($ClaimsApps))
| expand apmid
// app -> queues (90d alert history) -> queue managers (queue depth metric)
| lookup [
    fetch dt.davis.problems, from:-90d
    | sort timestamp desc
    | dedup display_id
    | filter contains(event.name, "IBMMQ_APP")
    | fieldsAdd apmid = concat("APP", substring(splitString(event.name, "IBMMQ_APP")[1], from:0, to:8))
    | expand eid = affected_entity_ids
    | lookup [ fetch `dt.entity.ibmmq:local_queue` | fields id, qName = entity.name ],
             sourceField: eid, lookupField: id, prefix: "lq."
    | filter isNotNull(lq.qName)
    | summarize alerts = count(), by:{apmid, queueName = lq.qName}
    | lookup [
        timeseries d = avg(ibmmq.queue.depth), by:{queue_manager, queue_name}, from:-24h
        | summarize qms = collectDistinct(queue_manager), by:{queue_name}
      ], sourceField: queueName, lookupField: queue_name, prefix: "m."
    | expand qm = m.qms
    | filter isNotNull(qm)
    | summarize qms = collectDistinct(qm), by:{apmid}
  ], sourceField: apmid, lookupField: apmid, prefix: "map."
| filter isNotNull(map.qms)
| expand qmName = map.qms
// DLQ depth per queue manager (current value)
| lookup [
    timeseries dlq = max(ibmmq.queue_manager.dlq_depth, scalar: true),
               by:{queue_manager}, from:-30m
    | fields queue_manager, dlq
  ], sourceField: qmName, lookupField: queue_manager, prefix: "d."
| filter coalesce(d.dlq, 0) > 0
// MQ server name and host ID
| lookup [
    timeseries a = avg(ibmmq.queue_manager.availability),
               by:{queue_manager, host.name, dt.entity.host}, from:-30m
    | summarize server = takeFirst(host.name),
                hostId = takeFirst(dt.entity.host),
                by:{queue_manager}
  ], sourceField: qmName, lookupField: queue_manager, prefix: "a."
// queue manager entity ID for Open with
| lookup [
    fetch `dt.entity.ibmmq:queue_manager`
    | fields qmEntityId = id, qmEntityName = entity.name
  ], sourceField: qmName, lookupField: qmEntityName, prefix: "e."
| fieldsAdd dlqMessages = round(d.dlq, decimals:0),
            status = if(d.dlq >= 100, "🔴 Critical", else: "🟠 Warning"),
            rank   = if(d.dlq >= 100, 1, else: 2)
| fieldsAdd appServerQm = concat(apmid, " | ", coalesce(a.server, "host n/a"), " : ", qmName)
| fields status, appServerQm, dlqMessages,
         `dt.entity.ibmmq:queue_manager` = e.qmEntityId,
         dt.entity.host = a.hostId,
         rank
| sort rank asc, dlqMessages desc
| fieldsRemove rank



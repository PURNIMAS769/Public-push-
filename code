metrics
| filter startsWith(metric.key, "ext:cloud.azure.microsoft_sql.managedinstances")
| sort metric.key asc

metrics
| filter contains(metric.key, "managedinstances")
| sort metric.key asc

timeseries io_requests = avg(`ext:cloud.azure.microsoft_sql.managedinstances.io_requests`),
           by:{dt.entity.custom_device}
| fieldsAdd avg_io = arrayAvg(io_requests)
| fieldsAdd mi_name = entityName(dt.entity.custom_device)
| sort avg_io desc
| limit 20

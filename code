Disk Usage — with time range added
fetch dt.entity.host
| filter arrayIndexOf(tags, "APMID:APP00005497") != -1
| fields id, hostname = entity.name

| join [
    timeseries disk = avg(dt.host.disk.used_percent, scalar:true), by:{dt.entity.host, dt.entity.disk}, from:-15d, interval:1h
  ], kind:leftOuter, on: left[id] == right[dt.entity.host]
| fieldsAdd disk_avg_pct = round(right.disk, decimals:2)
| fieldsAdd disk_name = entityName(right.dt.entity.disk, "dt.entity.disk")

| fields hostname, disk_name, disk_avg_pct, id
| sort disk_avg_pct desc

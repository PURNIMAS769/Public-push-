timeseries rd = avg(cloud.azure.microsoft_sql.managedinstances.io_bytes_read),
           by:{azure.resource.name, azure.resource.group, dt.smartscape_source.id},
           filter:{dt.da.source == "azure-metric-poller"}
| fieldsAdd avg_read = arrayAvg(rd)
| fieldsAdd rg_type = if(endsWith(azure.resource.group, "_ons"), "ONS",
                      else: if(endsWith(azure.resource.group, "_ofs"), "OFS", else: "Other"))
| fieldsAdd mi = concat(azure.resource.name, " (", rg_type, ")")
| fieldsAdd read_mb = rd[] / 1048576
| sort avg_read desc
| limit 10
| fields timeframe, interval, mi, read_mb


timeseries wr = avg(cloud.azure.microsoft_sql.managedinstances.io_bytes_written),
           by:{azure.resource.name, azure.resource.group, dt.smartscape_source.id},
           filter:{dt.da.source == "azure-metric-poller"}
| fieldsAdd avg_written = arrayAvg(wr)
| fieldsAdd rg_type = if(endsWith(azure.resource.group, "_ons"), "ONS",
                      else: if(endsWith(azure.resource.group, "_ofs"), "OFS", else: "Other"))
| fieldsAdd mi = concat(azure.resource.name, " (", rg_type, ")")
| fieldsAdd written_mb = wr[] / 1048576
| sort avg_written desc
| limit 10
| fields timeframe, interval, mi, written_mb

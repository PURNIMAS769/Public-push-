timeseries cpu = avg(cloud.azure.microsoft_sql.managedinstances.avg_cpu_percent),
           by:{azure.resource.name, azure.resource.group, dt.smartscape_source.id},
           filter:{dt.da.source == "azure-metric-poller"}
| fieldsAdd avg_cpu = arrayAvg(cpu)
| fieldsAdd rg_type = if(endsWith(azure.resource.group, "_ons"), "ONS",
                      else: if(endsWith(azure.resource.group, "_ofs"), "OFS", else: "Other"))
| fieldsAdd mi = concat(azure.resource.name, " (", rg_type, ")")
| sort avg_cpu desc
| limit 10
| fields timeframe, interval, mi, cpu

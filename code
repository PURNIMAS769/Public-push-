Host Uptime & Last Boot Time — SCCM Hosts
timeseries uptime_sec = avg(dt.host.uptime, scalar:true),
  by:{dt.entity.host},
  filter: dt.entity.host in [
    fetch dt.entity.host
    | filter arrayIndexOf(tags, "APMID:APP00005497") != -1
    | fields id
  ]
| fieldsAdd hostname = entityName(dt.entity.host)

| fieldsAdd uptime_days = floor(uptime_sec / 86400),
            uptime_hrs  = floor((uptime_sec % 86400) / 3600),
            uptime_mins = floor((uptime_sec % 3600) / 60)
| fieldsAdd uptime_formatted = concat(toString(uptime_days), "d ", toString(uptime_hrs), "h ", toString(uptime_mins), "m")

| fieldsAdd last_boot_time = now() - (uptime_sec * 1s)

| fieldsAdd reboot_status = if(uptime_days < 1, "Recently Rebooted",
                            else: if(uptime_days > 45, "Pending Reboot Review", else: "Normal"))

| fields hostname, uptime_formatted, last_boot_time, reboot_status
| sort uptime_sec asc

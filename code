timeseries cpu_usage = avg(dt.kubernetes.container.cpu_usage, scalar:true),
    by:{k8s.workload.name, k8s.namespace.name, k8s.cluster.name, k8s.container.name}, from:-24h
| filter k8s.namespace.name == "app00006805-accums-adjudication"
| fields cpu_usage, k8s.workload.name, k8s.container.name, k8s.cluster.name
| sort cpu_usage desc

Let's build Interpretation A — per-NIC breakdown
timeseries drop_rx = avg(dt.host.net.nic.packets.dropped.rx, scalar:true),
  by:{dt.entity.host, dt.entity.network_interface},
  filter: dt.entity.host in [
    fetch dt.entity.host
    | filter arrayIndexOf(tags, "APMID:APP00005497") != -1
    | fields id
  ]
| fieldsAdd hostname = entityName(dt.entity.host), nic_name = entityName(dt.entity.network_interface)
| fieldsAdd drop_rx = round(drop_rx, decimals:2)
| fields hostname, nic_name, drop_rx
| sort drop_rx desc

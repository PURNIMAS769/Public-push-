Disk Usage Forecast:

timeseries avg(dt.host.disk.used_percent), by:{dt.entity.host, dt.entity.disk},
  bins: 120, from:now()-7d, to:now(),
  filter: dt.entity.host in [
    fetch dt.entity.host | filter arrayIndexOf(tags, "APMID:APP00005497") != -1 | fields id
  ]


CPU Saturation Forecast (top-utilization hosts):

timeseries avg(dt.host.cpu.usage), by:{dt.entity.host},
  bins: 120, from:now()-7d, to:now(),
  filter: dt.entity.host in [
    fetch dt.entity.host | filter arrayIndexOf(tags, "APMID:APP00005497") != -1 | fields id
  ]



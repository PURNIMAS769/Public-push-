The coverage matrix — one query, built in DQL

Once those two run, this assembles everything into the single table that drives the dashboard design:

fetch dt.entity.host
| fields id, tags, tagStr = toString(tags)
| filter contains(lower(tagStr), "claim")
| expand tags
| filter contains(tags, "APP000") or contains(tags, "APP002")
| fieldsAdd apmid = if(contains(tags, "APMID:"), splitString(tags, "APMID:")[1], else: tags)
| filter startsWith(apmid, "APP")
| summarize hosts = countDistinctExact(id), by:{apmid}
| lookup [
    fetch dt.entity.service
    | fields id, tags, tagStr = toString(tags)
    | filter contains(lower(tagStr), "claim")
    | expand tags
    | filter contains(tags, "APP000") or contains(tags, "APP002")
    | fieldsAdd apmid = if(contains(tags, "APMID:"), splitString(tags, "APMID:")[1], else: tags)
    | filter startsWith(apmid, "APP")
    | summarize services = countDistinctExact(id), by:{apmid}
  ], sourceField: apmid, lookupField: apmid, fields: {services}
| fieldsAdd services = coalesce(services, 0)
| fieldsAdd coverage = if(hosts > 0 and services > 0, "Full",
                       else: if(hosts > 0, "Host only",
                       else: "Service only"))
| sort hosts desc

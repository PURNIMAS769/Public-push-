timeseries diskfree_pct = avg(dt.host.disk.free), by: { dt.entity.host, dt.entity.disk }, from:-30d
| fieldsAdd host_name = entityName(dt.entity.host)
| fieldsAdd disk_name = entityName(dt.entity.disk)
| fieldsAdd host_tags = entityAttr(dt.entity.host, "tags")
| filter arrayIndexOf(host_tags, "APMID:APP00002734") > -1
| fieldsAdd disk_usage_pct = 100 - diskfree_pct[]
| fields timeframe, interval, host_name, disk_name, disk_usage_pct, dt.entity.host, dt.entity.disk





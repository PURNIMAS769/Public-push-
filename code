timeseries {
    cpu_used = avg(dt.kubernetes.container.cpu_usage),
    mem_used = avg(dt.kubernetes.container.memory_working_set)
},
by: {k8s.namespace.name, k8s.container.name},
from: -15m
| fieldsAdd current_cpu = arrayLast(cpu_used), current_mem = arrayLast(mem_used)
| filter k8s.namespace.name == "app00002734-paperless-inventory"
| fields k8s.container.name, current_cpu, current_mem

| filter dt.osservice.status == "stopped" or dt.osservice.status == "failed"


timeseries a = avg(dt.osservice.availability),
  by:{ dt.entity.host, dt.osservice.status },
  filter: matchesPhrase(entityName(`dt.entity.os:service`), "SQL Server Agent"),
  from:-2h
| summarize host_count = countDistinct(dt.entity.host), by:{ dt.osservice.status }
| sort dt.osservice.status asc


timeseries from:-2h,
  by:{ dt.source_entity },
  count()
| filter matchesPhrase(toString(dt.source_entity), "CUSTOM_DEVICE")
| limit 20

fetch metric.series, from:-2h
| filter matchesPhrase(toString(dt.entity.custom_device), "CUSTOM_DEVICE-2669EEA5121311CF")
| summarize by:{ metric.key }
| limit 50

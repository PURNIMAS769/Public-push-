fetch `dt.entity.sql:db2_instance`, from:-24h
| fieldsAdd is_running = if(lifetime[end] > now() - 15m, true, else: false)
| lookup [
    timeseries avail = avg(db2.availability), by:{`dt.entity.sql:db2_instance`}, from:-15m
    | fieldsAdd latest_avail = arrayLast(avail)
  ], sourceField:id, lookupField:`dt.entity.sql:db2_instance`, prefix:"m_"
| fieldsAdd final_status = if(is_running == true and m_latest_avail >= 1, "UP", else: "DOWN")
| summarize
    total_instances = count(),
    up = countIf(final_status == "UP"),
    down = countIf(final_status == "DOWN")

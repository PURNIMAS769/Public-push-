fetch dt.entity.host
| filter arrayIndexOf(tags, "APMID:APP00005497") != -1 
| fields id, host.name = entity.name 
| join [ timeseries avail = avg(dt.host.availability), 
by:{dt.entity.host} ], kind:leftOuter, on: left[id] == right[dt.entity.host] 
| fieldsAdd latest_avail = arrayLast(avail) 
| fields host.name, latest_avail
| sort latest_avail asc


fetch dt.davis.problems 
| filter not(dt.davis.is_duplicate) and event.status == "ACTIVE" 
| expand affected_entity_ids | filter in(affected_entity_ids, array( fetch dt.entity.host 
| filter arrayIndexOf(tags, "APMID:APP00005497") != -1 | fields id )) 
| fields display_id, title, affected_entity_ids, event.start 
| sort event.start desc



fetch dt.entity.host
| filter arrayIndexOf(tags, "APMID:APP00005497") != -1
| fields id, host.name = entity.name

| join [
    timeseries avail = avg(dt.host.availability), by:{dt.entity.host}
    | fieldsAdd avail_pct = arrayLast(avail)
  ], kind:leftOuter, on: left[id] == right[dt.entity.host]

| join [
    fetch dt.davis.problems
    | filter not(dt.davis.is_duplicate) and event.status == "ACTIVE"
    | expand affected_entity_ids
    | summarize open_problems = collectDistinct(display_id), by:{affected_entity_ids}
  ], kind:leftOuter, on: left[id] == right[affected_entity_ids]

| fieldsAdd health_status = if(isNull(affected_entity_ids) and avail_pct == 100, "HEALTHY", "UNHEALTHY")
| fields host.name, avail_pct, open_problems, health_status
| sort health_status desc

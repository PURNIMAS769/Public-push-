fetch dt.davis.problems
| filter not(dt.davis.is_duplicate) and event.status == "ACTIVE"
| filter in("APMID:APP00006805", entity_tags)
| summarize
    problem_title = takeFirst(event.name),
    severity = takeFirst(event.category),
    status = takeFirst(event.status),
    root_cause = takeFirst(root_cause_entity_name),
    affected_types = takeFirst(affected_entity_types),
    start_time = takeFirst(event.start),
    problem_event_id = takeFirst(event.id),
    by:{display_id}
| fieldsAdd total_seconds = round((now() - start_time) / 1s, decimals:0)
| fieldsAdd hrs = floor(total_seconds / 3600), mins = floor((total_seconds % 3600) / 60)
| fieldsAdd age_formatted = concat(toString(hrs), "h ", toString(mins), "m")
| fieldsAdd `Entity Type` =
    if(contains(toString(affected_types), "dt.entity.process_group_instance"), "Process/Instance",
    else: if(contains(toString(affected_types), "dt.entity.cloud_application_instance"), "Pod",
    else: if(contains(toString(affected_types), "dt.entity.cloud_application"), "Kubernetes Deployment",
    else: if(contains(toString(affected_types), "dt.entity.cloud_application_namespace"), "Namespace",
    else: if(contains(toString(affected_types), "dt.entity.service"), "Service",
    else: if(contains(toString(affected_types), "dt.entity.custom_device"), "Custom Device (DB2/Mainframe)",
    else: "Other"))))))
| fieldsAdd problem_link = concat(
    "https://wdf17482.apps.dynatrace.com/ui/apps/dynatrace.davis.problems/problem/",
    problem_event_id, "?from=now()-24h&to=now()")
| fields display_id, problem_title, severity, status, `Entity Type`, root_cause, start_time, age_formatted, problem_link
| append [
    timeseries avg(dt.kubernetes.container.cpu_usage), by:{k8s.node.name, k8s.namespace.name}, from:-24h
    | filter k8s.namespace.name == "app00006805-accums-adjudication"
    | fields k8s.node.name
    | dedup k8s.node.name
    | lookup [
        fetch dt.entity.host
        | fields id, entity.name
    ], sourceField: k8s.node.name, lookupField: entity.name, fields: { dt.entity.host = id }
    | join [
        fetch dt.davis.problems, from:-10d
        | filter event.status == "ACTIVE"
        | expand affected_entity_ids
        | summarize
            problem_title = takeFirst(event.name),
            severity = takeFirst(event.category),
            status = takeFirst(event.status),
            root_cause = takeFirst(root_cause_entity_name),
            start_time = takeFirst(event.start),
            problem_event_id = takeFirst(event.id),
            by:{affected_entity_ids}
    ], kind:inner, on:{left[dt.entity.host] == right[affected_entity_ids]}, prefix:"p."
    | fieldsAdd total_seconds = round((now() - p.start_time) / 1s, decimals:0)
    | fieldsAdd hrs = floor(total_seconds / 3600), mins = floor((total_seconds % 3600) / 60)
    | fieldsAdd age_formatted = concat(toString(hrs), "h ", toString(mins), "m")
    | fieldsAdd `Entity Type` = "Host/Node"
    | fieldsAdd display_id = k8s.node.name
    | fieldsAdd problem_link = concat(
        "https://wdf17482.apps.dynatrace.com/ui/apps/dynatrace.davis.problems/problem/",
        p.problem_event_id, "?from=now()-24h&to=now()")
    | fields display_id, problem_title = p.problem_title, severity = p.severity, status = p.status, `Entity Type`, root_cause = p.root_cause, start_time = p.start_time, age_formatted, problem_link
]
| sort start_time desc

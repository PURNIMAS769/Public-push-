fetch dt.entity.host
| filter in(osType, {"LINUX", "SOLARIS", "AIX"})
| filter contains(toString(tags), "AYS:MSP_Unix")
| fieldsAdd tag_list = tags
| expand tag_list
| filter startsWith(tag_list, "APPName:")
| fieldsAdd app_name = splitString(tag_list, ":")[1]
| fields `Host Name` = entity.name, `OS Type` = osType, `Application Name` = app_name, `Host ID` = id
| sort `Application Name` asc, `Host Name` asc

fetch dt.davis.problems
| filter not(dt.davis.is_duplicate) and event.status == "ACTIVE"
| filter matchesPhrase(event.name, "Major_WindowsService_MSSQL")
| expand affected_entity_ids
| lookup [
    fetch `dt.entity.os:service`
    | fieldsAdd hid = runs_on[dt.entity.host]
    | fields id, hid
  ], sourceField:affected_entity_ids, lookupField:id, prefix:"s_"
| fieldsAdd mapped_host = entityName(s_hid)
| fields event.name, affected_entity_ids, s_hid, mapped_host
| limit 20

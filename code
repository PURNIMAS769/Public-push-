timeseries h = max(`sql-server.always-on.db.synchronizationHealth`, scalar: true),
           by:{device.name, availability.replica.name, availability.database.name,
               availability.database.synchronization_health,
               availability.database.synchronization_state}, from:-30m
| fieldsAdd hostShort = lower(splitString(device.name, ".")[0])
| lookup [
    fetch dt.entity.host
    | fields hostName = entity.name, tags
    | expand t = tags
    | filter startsWith(t, "APMID:")
    | fieldsAdd apmid = splitString(t, "APMID:")[1],
                hostShort = lower(splitString(hostName, ".")[0])
    | filter in(apmid, array($MembershipApps))
    | summarize apps = collectDistinct(apmid), by:{hostShort}
  ], sourceField: hostShort, lookupField: hostShort, prefix: "h."
| filter isNotNull(h.apps)
| expand apmid = h.apps
| fieldsAdd health    = availability.database.synchronization_health,
            syncState = availability.database.synchronization_state
| fieldsAdd status = if(health == "NOT_HEALTHY" or syncState == "NOT SYNCHRONIZING", "🔴 Critical",
                     else: if(health == "HEALTHY", "🟢 Healthy", else: "🟠 Warning")),
            rank   = if(health == "NOT_HEALTHY" or syncState == "NOT SYNCHRONIZING", 1,
                     else: if(health == "HEALTHY", 3, else: 2))
| filter status != "🟢 Healthy"
| fieldsAdd appServerDb = concat(apmid, " | ", device.name, " : ", availability.database.name)
| fields status, appServerDb, replica = availability.replica.name, health, syncState, rank
| sort rank asc, appServerDb asc
| fieldsRemove rank



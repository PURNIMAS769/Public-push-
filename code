fetch `dt.entity.sql:db2_host`
| fields id, host_name = entity.name
| filter isNotNull(host_name)
| summarize count(), by:{host_name}
| fields host_name
| sort host_name asc


fetch `dt.entity.sql:db2_instance`
| fields id, instance_name = entity.name
| filter isNotNull(instance_name)
| summarize count(), by:{instance_name}
| fields instance_name
| sort instance_name asc



fetch `dt.entity.sql:db2_database_member`
| fields id, member_name = entity.name
| filter isNotNull(member_name)
| summarize count(), by:{member_name}
| fields member_name
| sort member_name asc



fetch metric.series
| filter metric.key == "db2.hadr_state"
| fieldsAdd replica_pair = concat(primary_instance, " ↔ ", standby_instance)
| filter isNotNull(replica_pair)
| summarize count(), by:{replica_pair}
| fields replica_pair
| sort replica_pair asc



timeseries avg(dt.service.request.count), by:{dt.entity.service}
| fieldsAdd serviceName = entityName(dt.entity.service)
| filter contains(serviceName, "accums") or contains(serviceName, "Accum") or contains(serviceName, "dme")



fetch dt.entity.service
| filter contains(entity.name, "Accum") or contains(entity.name, "dme")
| fieldsAdd tags


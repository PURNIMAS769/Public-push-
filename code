fetch dt.davis.events, from:-12d
| expand affected_entity_ids
| filter contains(event.name, "restart") or contains(event.name, "Restart")
| lookup [
    fetch dt.entity.process_group_instance
    | filter arrayIndexOf(tags, "APMID:APP00006805") > -1
    | fields id, entity.name
], sourceField: affected_entity_ids, lookupField: id, fields: { process_name = entity.name }
| filter isNotNull(process_name)
| fields event.name, process_name, timestamp
| limit 20

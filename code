fetch `dt.entity.sql:db2_instance`, from:-24h
| fieldsAdd instance_id = id, instance_name = entity.name
| lookup [
    timeseries r = sum(db2.bp.total_logical_reads.count),
      by:{`dt.entity.sql:db2_instance`}, from:-24h
    | fieldsAdd instance_id = `dt.entity.sql:db2_instance`
    | fields instance_id, has_metric = true
  ], sourceField:instance_id, lookupField:instance_id, prefix:"m_"
| fieldsAdd reports_metric = if(isNotNull(m_has_metric), "YES", else:"NO")
| summarize instances = count(), by:{reports_metric}

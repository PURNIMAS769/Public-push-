fetch dt.entity.host
| filter arrayIndexOf(tags, "APMID:APP00002734") > -1
| fieldsAdd pg_ids = runs[dt.entity.process_group]
| expand pg_ids
| fieldsAdd process_name = entityName(pg_ids, type:"dt.entity.process_group")
| fields pg_ids, process_name, host_name = entity.name
| join [
    timeseries
        mem_max = avg(dt.runtime.jvm.memory.max, scalar:true, default:0),
        mem_total = avg(dt.runtime.jvm.memory.total, scalar:true, default:0),
        mem_free = avg(dt.runtime.jvm.memory.free, scalar:true, default:0),
    by: { dt.entity.process_group }
  ],
  kind: leftOuter,
  on: left[pg_ids] == right[`dt.entity.process_group`],
  fields: { mem_max, mem_total, mem_free }
| fieldsAdd `Heap Used (MB)` = round((mem_total - mem_free) / 1048576, decimals:1)
| fieldsAdd `Heap Free (MB)` = round(mem_free / 1048576, decimals:1)
| fieldsAdd `Heap Max (MB)` = round(mem_max / 1048576, decimals:1)
| fields host_name, process_name, `Heap Used (MB)`, `Heap Free (MB)`, `Heap Max (MB)`
| sort `Heap Used (MB)` desc
| limit 20

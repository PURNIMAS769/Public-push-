fetch metric.series
| filter contains(metric.key, "dt.service.request") or contains(metric.key, "dt.service.messaging")
| summarize count(), by:{metric.key}

timeseries
    total_requests = sum(dt.service.request.count),
    failed_requests = sum(dt.service.request.failure_count),
    avg_response_time = avg(dt.service.request.response_time),
    by:{dt.entity.service},
    from:-24h
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APMID:APP00006805\")"))
| fieldsAdd service_name = entityName(dt.entity.service)
| fieldsAdd total_sum = arraySum(total_requests)
| filter total_sum > 0



timeseries
    msg_process = sum(dt.service.messaging.process.count),
    msg_publish = sum(dt.service.messaging.publish.count),
    msg_receive = sum(dt.service.messaging.receive.count),
    by:{dt.entity.service},
    from:-24h
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APMID:APP00006805\")"))
| fieldsAdd service_name = entityName(dt.entity.service)



fetch spans
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APMID:APP00006805\")"))
| filter span.kind == "server"
| summarize count(), avg(duration), by:{http.response.status_code}
| limit 20

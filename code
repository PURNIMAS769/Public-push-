fetch dt.entity.host
| filter contains(entity.name, "stv-ig") or contains(entity.name, "sso-sg")
| fieldsAdd entity.name, tags, ipAddress


timeseries avg(dt.service.request.response_time), sum(dt.service.request.failure_count), by:{server.address}, from:now()-7d
| filter server.address == "p-sso-sg-prd-svc.hcscint.net" or server.address == "p-stv-ig-prd-svc.hcscint.net"

// ── 1) Authoritative RUNNING host universe → 547 ──
fetch dt.entity.host
| filter state == "RUNNING"
| filter matchesPhrase(toString(tags), "MSSQL")
         or matchesPhrase(toString(tags), "MSP_Database_MSSQL")   // safety net for untagged SQL hosts
| fieldsAdd host_name = entity.name
| fields id, host_name

// ── 2) LEFT-join the authoritative stopped-agent set (your 15) ──
| lookup [
    timeseries a = avg(dt.osservice.availability),
      by:{ dt.entity.host },
      filter: matchesPhrase(entityName(`dt.entity.os:service`), "SQL Server Agent")
              and dt.osservice.status == "stopped",
      from:-2h
    | summarize by:{ dt.entity.host }
    | fieldsAdd agent_stopped = 1
  ], sourceField:id, lookupField:dt.entity.host, prefix:"svc_"

// ── 3) Health verdict ──
| fieldsAdd health_status = if(svc_agent_stopped == 1, "UNHEALTHY", else:"HEALTHY")
| fields host_name, health_status, id
| sort health_status desc, host_name asc

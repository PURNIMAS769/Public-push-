fetch dt.entity.process_group_instance, from:-24h
| filter arrayIndexOf(tags, "APMID:APP00006805") > -1
| fieldsAdd is_running_15m = if(lifetime[end] > now() - 15m, true, else: false)
| fields entity.name, lifetime, is_running_15m
| sort is_running_15m asc


fetch dt.entity.process_group_instance, from:-24h
| filter arrayIndexOf(tags, "APMID:APP00006805") > -1
| fieldsAdd is_running = if(lifetime[end] > now() - 15m, true, else: false)
| join [
    fetch dt.davis.problems, from:-24h
    | filter event.status == "ACTIVE"
    | expand affected_entity_ids
    | summarize problem_count = countDistinct(event.id), by:{affected_entity_ids}
], kind:leftOuter, on:{left[id] == right[affected_entity_ids]}, prefix:"p."
| fieldsAdd open_problem_count = if(isNull(p.problem_count), 0, else: p.problem_count)
| fieldsAdd instance_state = if(is_running == false, "DOWN", else: if(open_problem_count > 0, "UNHEALTHY (Active Alert)", else: "HEALTHY"))
| summarize
    total_instances = count(),
    running_instances = countIf(is_running == true),
    healthy_instances = countIf(instance_state == "HEALTHY"),
    unhealthy_instances = countIf(instance_state == "UNHEALTHY (Active Alert)"),
    down_instances = countIf(instance_state == "DOWN")

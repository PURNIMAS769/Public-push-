Disk Read/Write IOPS (per MySQL host)

timeseries {
  read_ops = avg(dt.host.disk.read_ops, scalar:true),
  write_ops = avg(dt.host.disk.write_ops, scalar:true)
}, by: { dt.entity.host, dt.entity.disk }, from: -2h
| fieldsAdd instance = entityName(dt.entity.host)
| join [
    fetch metric.series
    | filter metric.key == "mysql.global_status.availability"
    | fieldsAdd instance = device.name
    | fields instance
    | dedup instance
  ], on: { instance }, kind: inner
| fieldsAdd disk_name = entityName(dt.entity.disk)
| fields dt.entity.host, instance, disk_name, read_ops, write_ops
| sort instance asc



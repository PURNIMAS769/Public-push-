timeseries vc = avg(cloud.azure.microsoft_sql.managedinstances.virtual_core_count),
           by:{azure.resource.name},
           filter:{dt.da.source == "azure-metric-poller"},
           from:-24h, to:now()
| fieldsAdd vcores = arrayLast(arrayRemoveNulls(vc))
| summarize Total_vCores = sum(vcores),
            MI_count = count(),
            MIs_without_value = countIf(isNull(vcores))

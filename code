fetch dt.kubernetes.events, from:-60d
| filter k8s.namespace.name == "app00002734-paperless-inventory"
| filter contains(event.reason, "Restart") or contains(event.reason, "Killing") or contains(event.reason, "BackOff")
| sort timestamp desc
| fields timestamp, k8s.pod.name, event.reason, event.message
| limit 5

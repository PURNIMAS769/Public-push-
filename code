fetch dt.entity.host
| filter in(osType, {"LINUX", "SOLARIS", "AIX"})
| filter contains(toString(tags), "AYS:MSP_Unix")
| fieldsAdd tag_list = tags
| expand tag_list
| filter contains(tag_list, ":")
| fieldsAdd tag_key = splitString(tag_list, ":")[0]
| summarize count(), by:{tag_key}
| sort count() desc

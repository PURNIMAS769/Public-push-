Tile 1 — Disk Read IOPS (per host)
timeseries read_ops = avg(dt.host.disk.read_ops, scalar:true),
  by:{dt.entity.host},
  filter: dt.entity.host in [
    fetch dt.entity.host
    | filter arrayIndexOf(tags, "APMID:APP00005497") != -1
    | fields id
  ]
| fieldsAdd hostname = entityName(dt.entity.host)
| fieldsAdd read_ops = round(read_ops, decimals:1)
| fields hostname, read_ops
| sort read_ops desc

Tile 2 — Disk Write IOPS (per host)
timeseries write_ops = avg(dt.host.disk.write_ops, scalar:true),
  by:{dt.entity.host},
  filter: dt.entity.host in [
    fetch dt.entity.host
    | filter arrayIndexOf(tags, "APMID:APP00005497") != -1
    | fields id
  ]
| fieldsAdd hostname = entityName(dt.entity.host)
| fieldsAdd write_ops = round(write_ops, decimals:1)
| fields hostname, write_ops
| sort write_ops desc


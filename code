fetch `dt.entity.mongodb:process`
| fieldsAdd process_id = id, process_name = entity.name
| lookup [
    timeseries active_clients = avg(mongodb.active_clients), by:{`dt.entity.mongodb:process`}, from:-2h
  ], sourceField:process_id, lookupField:`dt.entity.mongodb:process`, prefix:"m_"
| fieldsAdd interval = m_interval, timeframe = m_timeframe
| fields process_name, active_clients = m_active_clients, timeframe, interval


fetch `dt.entity.mongodb:process`
| fieldsAdd process_id = id, process_name = entity.name
| lookup [
    timeseries current_connections = avg(mongodb.current_connections), by:{`dt.entity.mongodb:process`}, from:-2h
  ], sourceField:process_id, lookupField:`dt.entity.mongodb:process`, prefix:"m_"
| fieldsAdd interval = m_interval, timeframe = m_timeframe
| fields process_name, current_connections = m_current_connections, timeframe, interval

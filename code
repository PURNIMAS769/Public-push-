fetch `dt.entity.sql:db2_database_member`
| fieldsAdd instance_ref = child_of[`dt.entity.sql:db2_instance`]
| lookup [
    fetch `dt.entity.sql:db2_instance`
    | fields id, instance_name = entity.name
  ], sourceField:instance_ref, lookupField:id, prefix:"i_"
| fieldsAdd member_name = entity.name
| filter isNotNull(member_name)
| summarize count(), by:{member_name}
| fields member_name

fetch dt.entity.host
| filter in(id, classicEntitySelector("type(HOST),tag(\"AIXDB2\")"))
    or in(id, classicEntitySelector("type(HOST),tag(\"LinuxDB2\")"))
| fieldsAdd host_name = entity.name
| filter isNotNull(host_name)
| fieldsAdd host_key = toLowercase(splitString(host_name, ".")[0])
| filter not(in(host_key, array(
    "pwausxtsmmgt03", "pwausligapp03", "pwauslmdmapp07", "pwausldsapp13",
    "pwausltsmoc01", "pwausligapp04", "pwausltsmmgt21", "pwausldsapp16"
  )))
| summarize count(), by:{host_name}
| fields host_name
| sort host_name asc

fetch dt.entity.service
| filter contains(toString(tags), "APMID:APP00006805")
| fieldsAdd id, entity.name, tags


timeseries sum(dt.service.database.query.count), by:{dt.entity.service}
| fieldsAdd serviceName = entityName(dt.entity.service)
| filter contains(serviceName, "ccum") or contains(serviceName, "dme")


fetch dt.entity.service_instance
| filter contains(toString(tags), "APMID:APP00006805")
| fieldsAdd entity.name, softwareTechnologies

Tile 1 — NIC Received Errors
timeseries err_rx = avg(dt.host.net.nic.packets.errors.rx, scalar:true),
  by:{dt.entity.host},
  filter: dt.entity.host in [
    fetch dt.entity.host
    | filter arrayIndexOf(tags, "APMID:APP00005497") != -1
    | fields id
  ]
| fieldsAdd hostname = entityName(dt.entity.host)
| fieldsAdd err_rx = round(err_rx, decimals:2)
| fields hostname, err_rx
| sort err_rx desc


Tile 5 — BDM/Claims Member Failure Rate
fetch spans, from:-2h, scanLimitGBytes: 100
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APMID:APP00006805\")"))
| filter server.address == "bdm-new-contract-lookup-api-service-prod.app00006808-benefit-data-management.svc.cluster.local" or server.address == "p-app00006809-claimsmembersvc-ga-prd.hcscint.net"
| fieldsAdd is_error = if(http.response.status_code >= 400, 1, else: 0)
| summarize total = count(), errors = sum(is_error), by:{server.address}
| fieldsAdd error_rate_pct = round((errors / total) * 100, decimals:2)






S0.2b — proper exclusivity test

fetch dt.entity.host
| fields id, name = entity.name, tags, tagStr = toString(tags)
| filter contains(lower(tagStr), "portfolio")
| expand tag = tags
| filter contains(lower(tag), "portfolio")
| fieldsAdd portfolio = splitString(tag, "Portfolio:")[1]
| summarize claimVals = countDistinctExact(if(contains(lower(portfolio), "claim"), portfolio)),
            otherVals = countDistinctExact(if(contains(lower(portfolio), "claim") == false, portfolio)),
            by:{id, name}
| filter claimVals > 0
| fieldsAdd exclusive = otherVals == 0
| summarize hosts = count(), by:{exclusive}



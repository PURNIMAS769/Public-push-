fetch events, from:-60d
| filter event.provider == "KUBERNETES_EVENT"
| filter k8s.namespace.name == "app00002734-paperless-inventory"
| filter contains(event.name, "restart") or contains(event.name, "Restart") or contains(event.name, "Kill") or contains(event.name, "BackOff")
| sort timestamp desc
| fields timestamp, k8s.pod.name, event.name, event.description
| limit 10

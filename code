S0.5 — resolve the Test/Dev vs Production conflict (run this first)

fetch dt.entity.host
| fields id, tagStr = toString(tags)
| filter contains(lower(tagStr), "portfolio:claims")
| fieldsAdd envTag = if(contains(tagStr, "CMDB_ENV:Production"), "ENV=Production",
                     else: if(contains(tagStr, "CMDB_ENV:"), "ENV=Other", else: "ENV=missing"))
| fieldsAdd nameHint = if(contains(lower(tagStr), "_test"), "name=Test",
                       else: if(contains(lower(tagStr), "_dev"), "name=Dev",
                       else: if(contains(lower(tagStr), "_prod"), "name=Prod", else: "name=unknown")))
| summarize hosts = countDistinctExact(id), by:{envTag, nameHint}
| sort hosts desc


A small cross-tab that settles it definitively.

S0.3b — three-tier classification

fetch dt.entity.host
| fields id, tags, tagStr = toString(tags)
| filter contains(lower(tagStr), "portfolio:claims")
| expand tag = tags
| filter contains(tag, "APMID:") or contains(tag, "APPID:")
| fieldsAdd apmid = if(contains(tag, "APMID:"), splitString(tag, "APMID:")[1],
                    else: splitString(tag, "APPID:")[1])
| filter startsWith(apmid, "APP")
| lookup [
    fetch dt.entity.host
    | fields id, tags, tagStr = toString(tags)
    | filter contains(lower(tagStr), "portfolio")
    | expand tag = tags
    | filter contains(lower(tag), "portfolio")
    | fieldsAdd portfolio = splitString(tag, "Portfolio:")[1]
    | summarize claimVals = countDistinctExact(if(contains(lower(portfolio), "claim"), portfolio)),
                otherVals = countDistinctExact(if(contains(lower(portfolio), "claim") == false, portfolio)),
                by:{id}
    | fieldsAdd exclusive = claimVals > 0 and otherVals == 0
    | fields id, exclusive
  ], sourceField: id, lookupField: id, prefix: "h."
| summarize hosts = countDistinctExact(id),
            exclusiveHosts = countDistinctExact(if(h.exclusive == true, id)),
            by:{apmid}
| fieldsAdd tier = if(hosts > 40, "C - Shared Platform",
                   else: if(exclusiveHosts > 0, "A - Confirmed Claims",
                   else: "B - Shared / Unverified"))
| sort tier asc, hosts desc

fetch `dt.entity.mongodb:process`
| fieldsAdd process_id = id, process_name = entity.name
| lookup [
    timeseries page_faults_total = avg(mongodb.page_faults), by:{`dt.entity.mongodb:process`}, from:-2h
    | fieldsAdd page_faults_delta = page_faults_total[] - shift(page_faults_total[], -1)
  ], sourceField:process_id, lookupField:`dt.entity.mongodb:process`, prefix:"m_"
| fieldsAdd interval = m_interval, timeframe = m_timeframe
| fields process_name, page_faults_delta = m_page_faults_delta, timeframe, interval

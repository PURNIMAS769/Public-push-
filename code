fetch dt.entity.custom_device
| filter contains(toString(technology), "NUTANIX") or contains(lower(entity.name), "nutanix")
| fields id, entity.name, technology

fetch dt.entity.host
| fieldsAdd hostGroup, tags, virtualizationInfo
| filter contains(toString(tags), "Nutanix") or contains(toString(hostGroup), "NUTANIX") or contains(toString(virtualizationInfo), "NUTANIX")
| fields id, entity.name, hostGroup, tags

Final CPU Usage — Forecast Source Query (SCCM hosts only)
timeseries cpu_usage = avg(dt.host.cpu.usage),
           avg_usage = avg(dt.host.cpu.usage, scalar:true),
  by:{dt.entity.host},
  filter: dt.entity.host in [
    fetch dt.entity.host
    | filter arrayIndexOf(tags, "APMID:APP00005497") != -1
    | fields id
  ],
  from:-15d, interval:1h
| fieldsAdd host.name = entityName(dt.entity.host)
| sort avg_usage desc
| limit 20

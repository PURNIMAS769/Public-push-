timeseries index_size = avg(mongodb.db.db_index_size), by:{`dt.entity.mongodb:database`}
| lookup [ fetch `dt.entity.mongodb:database` | fields id, db_name = entity.name ],
    sourceField:`dt.entity.mongodb:database`, lookupField:id, prefix:"d_"
| fieldsAdd index_size_mb = round(arrayLast(index_size) / 1024 / 1024, decimals:2)
| filter isNotNull(index_size_mb)
| fields db_name = d_db_name, index_size_mb
| filter isEmpty(array($database)) or in(db_name, array($database))
| sort index_size_mb desc
| limit 50

timeseries cpu_used = sum(dt.kubernetes.container.cpu_usage),
by:{k8s.namespace.name, k8s.container.name},
from:-24h
| filter k8s.namespace.name == "app00002734-paperless-inventory"
| fields timeframe, interval, k8s.container.name, cpu_used


---------------------------
timeseries mem_used = sum(dt.kubernetes.container.memory_working_set),
by:{k8s.namespace.name, k8s.container.name},
from:-24h
| filter k8s.namespace.name == "app00002734-paperless-inventory"
| fields timeframe, interval, k8s.container.name, mem_used
----------------------------------
timeseries
    cpu_used = sum(dt.kubernetes.container.cpu_usage, default:0),
    cpu_limit = sum(dt.kubernetes.container.cpu_limit, default:0),
    by:{k8s.namespace.name, k8s.container.name},
    from:-24h
| filter k8s.namespace.name == "app00002734-paperless-inventory"
| fieldsAdd cpu_saturation_pct = 100.0 * cpu_used[] / cpu_limit[]
| fields timeframe, interval, k8s.container.name, cpu_saturation_pct


---------------------------------------------------
timeseries
    mem_used = sum(dt.kubernetes.container.memory_working_set, default:0),
    mem_limit = sum(dt.kubernetes.container.memory_limit, default:0),
    by:{k8s.namespace.name, k8s.container.name},
    from:-24h
| filter k8s.namespace.name == "app00002734-paperless-inventory"
| fieldsAdd mem_saturation_pct = 100.0 * mem_used[] / mem_limit[]
| fields timeframe, interval, k8s.container.name, mem_saturation_pct

timeseries r = sum(db2.bp.total_logical_reads.count),
  by:{`dt.entity.sql:db2_host`, device.name, device.address, instance_name}, from:-24h
| fieldsAdd db2_host_name = entityName(`dt.entity.sql:db2_host`)
| fields db2_host_name, device.name, device.address, instance_name
| sort db2_host_name asc
| limit 200

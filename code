T1: Exact metric keys for throughput, link utilization, latency and round trip

fetch metric.series, from:-2h
| filter startsWith(metric.key, "dt.host.net.nic.bytes")
      or startsWith(metric.key, "dt.host.net.nic.link")
      or startsWith(metric.key, "dt.process.network.latency")
      or startsWith(metric.key, "dt.process.network.round_trip")
| summarize series = count(), by:{metric.key}
| sort metric.key asc


T2: Latency and round trip on Claims apps

timeseries {lat = avg(dt.process.network.latency),
            rtt = avg(dt.process.network.round_trip)},
           by:{dt.entity.process_group_instance}, from:-2h
| fieldsAdd latAvg = arrayAvg(lat), rttAvg = arrayAvg(rtt)
| lookup [ fetch dt.entity.process_group_instance | fields id, tags ],
         sourceField: dt.entity.process_group_instance, lookupField: id, prefix: "e."
| expand tag = e.tags
| filter startsWith(tag, "APMID:")
| fieldsAdd apmid = splitString(tag, "APMID:")[1]
| filter in(apmid, array($ClaimsApps))
| summarize processes = countDistinctExact(dt.entity.process_group_instance),
            avgLatency  = round(avg(latAvg), decimals:2),
            maxLatency  = round(max(latAvg), decimals:2),
            avgRtt      = round(avg(rttAvg), decimals:2),
            maxRtt      = round(max(rttAvg), decimals:2),
            by:{apmid}
| sort maxRtt desc



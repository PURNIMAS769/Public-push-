timeseries used     = avg(cloud.azure.microsoft_sql.managedinstances.storage_space_used_mb),
           reserved = avg(cloud.azure.microsoft_sql.managedinstances.reserved_storage_mb),
           by:{azure.resource.name, azure.resource.group, dt.smartscape_source.id},
           filter:{dt.da.source == "azure-metric-poller"}
| fieldsAdd used_mb     = arrayAvg(used),
            reserved_mb = arrayAvg(reserved)
| fieldsAdd storage_pct = if(reserved_mb > 0, round(used_mb / reserved_mb * 100, decimals:2))
| fieldsAdd used_gb     = round(used_mb / 1024, decimals:1),
            reserved_gb = round(reserved_mb / 1024, decimals:1),
            free_gb     = round((reserved_mb - used_mb) / 1024, decimals:1)
| fieldsAdd storage_status = if(isNull(storage_pct), "No data",
                             else: if(storage_pct >= 90, "Critical",
                             else: if(storage_pct >= 80, "Warning", else: "Healthy")))
| fieldsAdd environment = if(contains(azure.resource.group, "_dev_"), "Dev",
                          else: if(contains(azure.resource.group, "_test_"), "Test", else: "Other")),
            rg_type = if(endsWith(azure.resource.group, "_ons"), "ONS",
                      else: if(endsWith(azure.resource.group, "_ofs"), "OFS", else: "Other"))
| fieldsAdd match_key = concat(lower(azure.resource.name), "|", lower(azure.resource.group))
| lookup [
    fetch dt.entity.custom_device
    | fieldsAdd rg = lower(toString(customProperties[`Resource group`]))
    | filter contains(rg, "app00046507")
    | fields cd_id = id, key = concat(lower(entity.name), "|", rg)
  ], sourceField:match_key, lookupField:key, fields:{cd_id}
| fields mi_name = azure.resource.name, rg_type, storage_pct, storage_status,
         used_gb, free_gb, reserved_gb, environment,
         dt.entity.custom_device = cd_id
| sort storage_pct desc

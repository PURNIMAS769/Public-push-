Tile: NIC Link Utilization % (In/Out)

timeseries {
  link_util_rx = avg(dt.host.net.nic.link_util_rx, scalar:true),
  link_util_tx = avg(dt.host.net.nic.link_util_tx, scalar:true)
}, by: { dt.entity.host }, from: -2h
| fieldsAdd instance = entityName(dt.entity.host)
| join [
    fetch metric.series
    | filter metric.key == "mysql.global_status.availability"
    | fieldsAdd instance = device.name
    | fields instance
    | dedup instance
  ], on: { instance }, kind: inner
| fields dt.entity.host, instance, link_util_rx, link_util_tx
| sort instance asc


timeseries requests = sum(dt.service.request.count),
by:{dt.entity.service},
from:-30d
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APMID:APP00002734\")"))
| fieldsAdd service_name = entityName(dt.entity.service)
| fieldsAdd total_check = arraySum(requests)
| filter isNotNull(total_check) and total_check > 0
| fields timeframe, interval, service_name, requests


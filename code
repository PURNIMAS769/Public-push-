timeseries {
    used_memory = avg(dt.kubernetes.resourcequota.requests_memory_used),
    max_memory = avg(dt.kubernetes.resourcequota.requests_memory)
},
by: {k8s.cluster.name, k8s.namespace.name, k8s.resourcequota.name},
from: -30d
| filter k8s.namespace.name == "app00002734-paperless-inventory"
| fieldsAdd memory_used_percent = 100.0 * used_memory[] / max_memory[]
| fields timeframe, interval, k8s.cluster.name, k8s.namespace.name, k8s.resourcequota.name, memory_used_percent





CPU Usage % — Top hosts (≥10%)
fetch dt.entity.host
| filter arrayIndexOf(tags, "APMID:APP00005497") != -1
| fields id, hostname = entity.name

| join [
    timeseries cpu = avg(dt.host.cpu.usage), by:{dt.entity.host}
  ], kind:leftOuter, on: left[id] == right[dt.entity.host]
| fieldsAdd cpu_avg_pct = round(arrayAvg(right.cpu), decimals:2)

| filter cpu_avg_pct >= 10
| fields hostname, cpu_avg_pct
| sort cpu_avg_pct desc

Memory Used % — Top hosts (≥41%)
fetch dt.entity.host
| filter arrayIndexOf(tags, "APMID:APP00005497") != -1
| fields id, hostname = entity.name

| join [
    timeseries mem = avg(dt.host.memory.usage), by:{dt.entity.host}
  ], kind:leftOuter, on: left[id] == right[dt.entity.host]
| fieldsAdd mem_avg_pct = round(arrayAvg(right.mem), decimals:2)

| filter mem_avg_pct >= 41
| fields hostname, mem_avg_pct
| sort mem_avg_pct desc

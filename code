fetch dt.entity.service
| filter entity.name == "DP0C" or entity.name == "DC0C" or entity.name == "DT0C"
| filter contains(toString(tags), "APMID:APP00006805")
| fields entity.name, id, tags


fetch spans, from:-2h, scanLimitGBytes: 200
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APMID:APP00006805\")"))
| filter span.kind == "client"
| summarize count(), by:{server.address}
| sort count() desc
| limit 30

fetch spans, from:-24h, scanLimitGBytes: 200
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APMID:APP00006805\")"))
| filter span.kind == "client"
| filter contains(server.address, "claimsmember") or contains(server.address, "006809")


fetch spans, from:-2h, scanLimitGBytes: 200
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APMID:APP00006805\")"))
| filter span.kind == "client"
| summarize count(), by:{server.address}
| sort count() desc
| limit 30

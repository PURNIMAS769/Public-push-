timeseries {
  used = avg(dt.host.disk.used, scalar:true),
  avail = avg(dt.host.disk.avail, scalar:true)
}, by: { dt.entity.host, dt.entity.disk }, from: -2h
| fieldsAdd instance = entityName(dt.entity.host)
| join [
    fetch metric.series
    | filter metric.key == "mysql.global_status.availability"
    | fieldsAdd instance = device.name
    | fields instance
    | dedup instance
  ], on: { instance }, kind: inner
| fieldsAdd disk_name = entityName(dt.entity.disk)
| fields dt.entity.host, instance, disk_name, used, avail
| sort instance asc


metrics
| filter startsWith(metric.key, "dt.host.disk")
| sort metric.key asc


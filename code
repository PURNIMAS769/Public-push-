fetch spans, from:-24h, scanLimitGBytes: 100
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APMID:APP00006805\")"))
| filter span.name == "CONNECT DP0C" or span.name == "SELECT DP0C" or span.name == "PREPARE DP0C"
| fieldsAdd service_name = entityName(dt.entity.service)
| fieldsAdd is_connect = if(span.name == "CONNECT DP0C", 1, else: 0)
| fieldsAdd is_select = if(span.name == "SELECT DP0C", 1, else: 0)
| fieldsAdd is_prepare = if(span.name == "PREPARE DP0C", 1, else: 0)
| summarize
    CONNECT = sum(is_connect),
    SELECT = sum(is_select),
    PREPARE = sum(is_prepare),
    by:{service_name}
| fieldsAdd Total = CONNECT + SELECT + PREPARE
| sort Total desc

fetch spans, from:-24h
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APMID:APP00006805\")"))
| filter span.name == "CONNECT DP0C" or span.name == "SELECT DP0C" or span.name == "PREPARE DP0C"
| summarize op_count = count(), by:{bin(timestamp, 1h), span.name}
| sort timestamp asc

Memory Usage in GB — Total vs Used, per SCCM Host
timeseries used_b  = avg(dt.host.memory.used, scalar:true),
           avail_b = avg(dt.host.memory.avail.bytes, scalar:true),
  by:{dt.entity.host},
  filter: dt.entity.host in [
    fetch dt.entity.host
    | filter arrayIndexOf(tags, "APMID:APP00005497") != -1
    | fields id
  ]
| fieldsAdd hostname = entityName(dt.entity.host)
| fieldsAdd total_gib = round((used_b + avail_b) / 1073741824, decimals:1)
| fieldsAdd used_gib  = round(used_b / 1073741824, decimals:1)
| fieldsAdd used_pct  = round((used_b / (used_b + avail_b)) * 100, decimals:2)
| fields hostname, total_gib, used_gib, used_pct
| sort used_pct desc

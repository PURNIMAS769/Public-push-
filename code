fetch events, from:-90d
| filter event.provider == "KUBERNETES_EVENT"
| filter k8s.namespace.name == "app00002734-paperless-inventory"
| filter contains(event.name, "Stopping container")
    or contains(event.name, "Started container")
    or contains(event.name, "Created pod")
    or contains(event.name, "Node is not ready")
| sort timestamp desc
| fields timestamp, k8s.pod.name, event.name
| limit 20

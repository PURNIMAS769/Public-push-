Tile 1 — Traffic Out (trend, top 20)

timeseries traffic_out = avg(dt.host.net.nic.bytes_tx),
  by:{dt.entity.host},
  filter: dt.entity.host in [
    fetch dt.entity.host
    | filter in(entity.name, array(
        "PFTWSWIFSC02.prd.hcscad.net","PFTWSWIFSC03.prd.hcscad.net","PFTWSWIFSC04.prd.hcscad.net",
        "PWAUSWIFSC08.prd.hcscad.net","PWAUSWIFSC09.prd.hcscad.net","PWAUSWIFSC10.prd.hcscad.net",
        "PWAUSWIFSC11.prd.hcscad.net","PWAUSWIFSC12.prd.hcscad.net","PWAUSWIFSC13.prd.hcscad.net",
        "PWAUSWIFSC14.prd.hcscad.net","PWAUSWIFSC15.prd.hcscad.net"
      ))
    | fields id
  ]
| fieldsAdd hostname = entityName(dt.entity.host)
| sort arrayLast(traffic_out) desc
| limit 20


Tile 2 — Traffic In (trend, top 20) — identical, just swap bytes_tx → bytes_rx:

timeseries traffic_in = avg(dt.host.net.nic.bytes_rx),
  by:{dt.entity.host},
  filter: dt.entity.host in [
    fetch dt.entity.host
    | filter in(entity.name, array(
        "PFTWSWIFSC02.prd.hcscad.net","PFTWSWIFSC03.prd.hcscad.net","PFTWSWIFSC04.prd.hcscad.net",
        "PWAUSWIFSC08.prd.hcscad.net","PWAUSWIFSC09.prd.hcscad.net","PWAUSWIFSC10.prd.hcscad.net",
        "PWAUSWIFSC11.prd.hcscad.net","PWAUSWIFSC12.prd.hcscad.net","PWAUSWIFSC13.prd.hcscad.net",
        "PWAUSWIFSC14.prd.hcscad.net","PWAUSWIFSC15.prd.hcscad.net"
      ))
    | fields id
  ]
| fieldsAdd hostname = entityName(dt.entity.host)
| sort arrayLast(traffic_in) desc

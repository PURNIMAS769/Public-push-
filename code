| expand affected_entity_ids
| filter contains(event.name, "restarted")
| filter in(affected_entity_ids, {
    "PROCESS_GROUP_INSTANCE-44EBF6BD68453B6D",
    "PROCESS_GROUP_INSTANCE-5DCAB95FA3B707B1",
    "PROCESS_GROUP_INSTANCE-9A4BE6A38ED7F448"
})
| fields entity_id_str = affected_entity_ids, event.name, timestamp

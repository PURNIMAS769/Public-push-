timeseries restarts = sum(dt.kubernetes.container.restarts),
by:{dt.entity.cloud_application_namespace},
from:-24h
| fieldsAdd namespace = entityName(dt.entity.cloud_application_namespace)
| fieldsAdd total = arraySum(restarts)
| filter total > 0
| fields namespace, total
| limit 20



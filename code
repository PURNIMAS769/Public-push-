fetch dt.entity.cloud_application_namespace
| fields entity.name, id


--------------------------------


timeseries restarts = sum(dt.kubernetes.container.restarts),
by:{dt.entity.cloud_application_namespace},
from:-24h
| fieldsAdd namespace = entityName(dt.entity.cloud_application_namespace)
| fieldsAdd total = arraySum(restarts)
| filter total > 0
| fields namespace, total


---------------------------------------


timeseries restarts = sum(dt.kubernetes.container.restarts),
by:{dt.entity.cloud_application},
from:-24h
| fieldsAdd deployment_name = entityName(dt.entity.cloud_application)
| filter contains(deployment_name, "pprlessinv")
| fields timeframe, interval, deployment_name, restarts

Backup coverage check

This counts ONLINE Membership databases and how many have a full-backup age. It includes system databases such as master and tempdb, which skew the gap slightly.

timeseries st = max(`sql-server.databases.state`, scalar: true),
           by:{device.name, database}, from:-30m
| filter st == 0
| fieldsAdd key = concat(device.name, "|", database),
            hostShort = lower(splitString(device.name, ".")[0])
| lookup [
    timeseries age = max(`sql-server.databases.backup.age`, scalar: true),
               by:{device.name, database, backup_type}, from:-2h
    | filter backup_type == "Full"
    | fieldsAdd key = concat(device.name, "|", database)
    | fields key, age
  ], sourceField: key, lookupField: key, prefix: "b."
| lookup [
    fetch dt.entity.host
    | fields hostName = entity.name, tags
    | expand t = tags
    | filter startsWith(t, "APMID:")
    | fieldsAdd apmid = splitString(t, "APMID:")[1],
                hostShort = lower(splitString(hostName, ".")[0])
    | filter in(apmid, array($MembershipApps))
    | summarize apps = collectDistinct(apmid), by:{hostShort}
  ], sourceField: hostShort, lookupField: hostShort, prefix: "h."
| filter isNotNull(h.apps)
| summarize `Online databases`     = count(),
            `With full backup age` = countIf(isNotNull(b.age)),
            `No full backup age`   = countIf(isNull(b.age))



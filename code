fetch `dt.entity.mongodb:process`
| fieldsAdd process_id = id, process_name = entity.name
| lookup [
    timeseries regular = avg(mongodb.regular_asserts2.count, scalar:true), by:{`dt.entity.mongodb:process`}, from:-2h
  ], sourceField:process_id, lookupField:`dt.entity.mongodb:process`, prefix:"r_"
| lookup [
    timeseries warning = avg(mongodb.warning_asserts2.count, scalar:true), by:{`dt.entity.mongodb:process`}, from:-2h
  ], sourceField:process_id, lookupField:`dt.entity.mongodb:process`, prefix:"w_"
| lookup [
    timeseries message = avg(mongodb.message_asserts2.count, scalar:true), by:{`dt.entity.mongodb:process`}, from:-2h
  ], sourceField:process_id, lookupField:`dt.entity.mongodb:process`, prefix:"msg_"
| lookup [
    timeseries user = avg(mongodb.user_asserts2.count, scalar:true), by:{`dt.entity.mongodb:process`}, from:-2h
  ], sourceField:process_id, lookupField:`dt.entity.mongodb:process`, prefix:"u_"
| lookup [
    timeseries rollover = avg(mongodb.rollover_asserts2.count, scalar:true), by:{`dt.entity.mongodb:process`}, from:-2h
  ], sourceField:process_id, lookupField:`dt.entity.mongodb:process`, prefix:"ro_"
| fields process_name,
    regular_asserts = round(r_regular, decimals:0),
    warning_asserts = round(w_warning, decimals:0),
    message_asserts = round(msg_message, decimals:0),
    user_asserts = round(u_user, decimals:0),
    rollover_asserts = round(ro_rollover, decimals:0)
| sort regular_asserts desc

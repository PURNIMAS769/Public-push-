fetch dt.davis.events, from:-30d
| filter event.type == "DEPLOYMENT_CHANGED_CHANGE"
   or event.type == "DEPLOYMENT_CHANGED_NEW"
   or event.type == "PROCESS_RESTART"
   or event.type == "AVAILABILITY_EVENT"
   or event.type == "CUSTOM_ALERT"
   or event.type == "METRIC_CHANGEPOINT"
| expand affected_entity_ids
| lookup [
    fetch dt.entity.host
    | filter arrayIndexOf(tags, "APPName:Blue_Chip_Benefit_Determination_Prod") > -1
    | fields id, entity.name
  ], sourceField: affected_entity_ids, lookupField: id, fields: { host_name = entity.name }
| lookup [
    fetch dt.entity.process_group_instance
    | filter arrayIndexOf(tags, "APPName:Blue_Chip_Benefit_Determination_Prod") > -1
    | fields id, entity.name
  ], sourceField: affected_entity_ids, lookupField: id, fields: { pgi_name = entity.name }
| lookup [
    fetch dt.entity.service
    | filter arrayIndexOf(tags, "APPName:Blue_Chip_Benefit_Determination_Prod") > -1
    | fields id, entity.name
  ], sourceField: affected_entity_ids, lookupField: id, fields: { service_name = entity.name }
| filter isNotNull(host_name) or isNotNull(pgi_name) or isNotNull(service_name)
| fieldsAdd entity_layer = if(isNotNull(host_name), "Host", else: if(isNotNull(pgi_name), "Process", else: "Service"))
| fieldsAdd entity_name = if(isNotNull(host_name), host_name, else: if(isNotNull(pgi_name), pgi_name, else: service_name))
| fieldsAdd `Change Type` =
    if(event.type == "DEPLOYMENT_CHANGED_CHANGE" or event.type == "DEPLOYMENT_CHANGED_NEW",
        if(entity_layer == "Service", "Service Deployment Changed", else: "Deployment Changed"),
    else: if(event.type == "PROCESS_RESTART", "Process Restart",
    else: if(event.type == "AVAILABILITY_EVENT" and contains(event.name, "reboot", caseSensitive:false), "Host Rebooted",
    else: if(event.type == "AVAILABILITY_EVENT" and contains(event.name, "shutdown", caseSensitive:false), "Host Shutdown",
    else: if(event.type == "METRIC_CHANGEPOINT",
        if(entity_layer == "Host", "Host Metric Changepoint",
        else: if(entity_layer == "Process", "Process Metric Changepoint", else: "Service Metric Changepoint")),
    else: if(event.type == "CUSTOM_ALERT",
        if(entity_layer == "Host", "Host Custom Alert",
        else: if(entity_layer == "Process", "Process Custom Alert", else: "Service Custom Alert")),
    else: "Other Change"))))))
| summarize event_count = count(), by:{ day = bin(event.start, 1d), `Change Type`, entity_layer, entity_name }
| sort day desc, entity_layer asc

fetch dt.entity.kubernetes_node
| filter arrayIndexOf(tags, "APPName:Blue_Chip_Benefit_Determination_Prod") > -1 
   or arrayIndexOf(tags, "APP00005875") > -1
| fields id, entity.name, tags

fetch dt.entity.cloud_application
| filter arrayIndexOf(tags, "APPName:Blue_Chip_Benefit_Determination_Prod") > -1 
   or arrayIndexOf(tags, "APP00005875") > -1
| fields id, entity.name, tags, namespaceName

fetch dt.entity.kubernetes_cluster
| filter arrayIndexOf(tags, "APPName:Blue_Chip_Benefit_Determination_Prod") > -1 
   or arrayIndexOf(tags, "APP00005875") > -1
| fields id, entity.name, tags

fetch dt.entity.host
| filter arrayIndexOf(tags, "APPName:Blue_Chip_Benefit_Determination_Prod") > -1
| fieldsAdd is_k8s_node = isNotNull(kubernetes_node_name)
| fields id, entity.name, is_k8s_node


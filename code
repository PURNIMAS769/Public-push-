fetch dt.entity.host
| filter arrayIndexOf(tags, "APPName:Blue_Chip_Benefit_Determination_Prod") > -1
| fields id, host_name = entity.name
| join [
    fetch dt.davis.problems, from: -10d
    | filter event.status == "ACTIVE"
    | expand affected_entity_ids
    | summarize
        problem_count = countDistinct(event.id),
        categories = collectDistinct(event.category),
      by: { affected_entity_ids }
  ],
  kind: leftOuter,
  on: { left[id] == right[affected_entity_ids] },
  fields: { problem_count, categories }
| fieldsAdd open_problem_count = if(isNull(problem_count), 0, else: problem_count)
| fieldsAdd host_state = if(arrayIndexOf(categories, "AVAILABILITY") > -1, "UNAVAILABLE",
    else: if(open_problem_count > 0, "UNHEALTHY",
    else: "HEALTHY"))
| summarize
    Total_Hosts = count(),
    Healthy_Count = countIf(host_state == "HEALTHY"),
    Unhealthy_Count = countIf(host_state == "UNHEALTHY"),
    Unavailable_Count = countIf(host_state == "UNAVAILABLE")
| fields Total_Hosts, Healthy_Count, Unhealthy_Count, Unavailable_Count

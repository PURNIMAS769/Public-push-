fetch spans, from:-2h, scanLimitGBytes: 200
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APMID:APP00006805\")"))
| filter contains(server.address, "bdm-new-contract-lookup")
| summarize op_count = count(), by:{bin(start_time, 15m)}
| sort start_time asc


fetch spans, from:-2h, scanLimitGBytes: 200
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APMID:APP00006805\")"))
| filter contains(server.address, "bdm-new-contract-lookup")
| summarize avg_duration_ms = avg(duration)/1000, by:{bin(start_time, 15m)}
| sort start_time asc


fetch spans, from:-2h, scanLimitGBytes: 200
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APMID:APP00006805\")"))
| filter contains(server.address, "bdm-new-contract-lookup")
| fieldsAdd endpoint = concat(toString(span.name), " ", toString(url.path))
| summarize op_count = count(), avg_duration_ms = avg(duration)/1000, by:{endpoint}
| sort op_count desc



fetch spans, from:-2h, scanLimitGBytes: 200
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APMID:APP00006805\")"))
| filter contains(server.address, "bdm-new-contract-lookup")
| fieldsAdd is_error = if(http.response.status_code >= 400, 1, else: 0)
| summarize total = count(), errors = sum(is_error), by:{server.address}
| fieldsAdd error_rate_pct = round((errors / total) * 100, decimals:2)


fetch spans, from:-7d, scanLimitGBytes: 300
| filter in(dt.entity.service, classicEntitySelector("type(service),tag(\"APMID:APP00006805\")"))
| filter contains(server.address, "claimsmember") or contains(server.address, "006809")
| summarize count(), by:{server.address}

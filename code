timeseries s = max(ibmmq.channel.status),
           by:{queue_manager, channel_name, channel_type, channel_status},
           from:-15m, interval:1m
// keep only the status each channel is reporting now (not an old status from earlier in the window)
| filter arraySize(arrayRemoveNulls(arraySlice(s, from:-3))) > 0
| filter in(channel_status, {"Stopped", "Retrying", "Paused", "Binding", "Stopping"})
// app -> queue managers (90d alert history -> queue depth metric)
| lookup [
    fetch dt.davis.problems, from:-90d
    | sort timestamp desc
    | dedup display_id
    | filter contains(event.name, "IBMMQ_APP")
    | fieldsAdd apmid = concat("APP", substring(splitString(event.name, "IBMMQ_APP")[1], from:0, to:8))
    | filter in(apmid, array($ClaimsApps))
    | expand eid = affected_entity_ids
    | lookup [ fetch `dt.entity.ibmmq:local_queue` | fields id, qName = entity.name ],
             sourceField: eid, lookupField: id, prefix: "lq."
    | filter isNotNull(lq.qName)
    | summarize by_q = count(), by:{apmid, queueName = lq.qName}
    | lookup [
        timeseries d = avg(ibmmq.queue.depth), by:{queue_manager, queue_name}, from:-24h
        | summarize qms = collectDistinct(queue_manager), by:{queue_name}
      ], sourceField: queueName, lookupField: queue_name, prefix: "m."
    | expand qm = m.qms
    | filter isNotNull(qm)
    | summarize qmList = collectDistinct(qm), by:{apmid}
    | expand qmName = qmList
    | fields apmid, qmName
  ], sourceField: queue_manager, lookupField: qmName, prefix: "map."
| filter isNotNull(map.apmid)
| fieldsAdd apmid = map.apmid
// MQ server name and host ID
| lookup [
    timeseries a = avg(ibmmq.queue_manager.availability),
               by:{queue_manager, host.name, dt.entity.host}, from:-30m
    | summarize server = takeFirst(host.name),
                hostId = takeFirst(dt.entity.host),
                by:{queue_manager}
  ], sourceField: queue_manager, lookupField: queue_manager, prefix: "a."
// entity IDs for Open with
| lookup [
    fetch `dt.entity.ibmmq:queue_manager`
    | fields qmEntityId = id, qmEntityName = entity.name
  ], sourceField: queue_manager, lookupField: qmEntityName, prefix: "e."
| fieldsAdd status = if(channel_status == "Stopped" or channel_status == "Retrying",
                        "🔴 Critical", else: "🟠 Warning"),
            rank   = if(channel_status == "Stopped" or channel_status == "Retrying", 1, else: 2)
| fieldsAdd appQmChannel = concat(apmid, " | ", coalesce(a.server, "host n/a"), " : ", queue_manager, " / ", channel_name)
| fields status, appQmChannel, channelStatus = channel_status, channelType = channel_type,
         `dt.entity.ibmmq:queue_manager` = e.qmEntityId,
         dt.entity.host = a.hostId,
         rank
| sort rank asc, appQmChannel asc
| fieldsRemove rank



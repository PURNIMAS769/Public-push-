fetch metric.series
| filter contains(metric.key, "mule")
| summarize count(), by:{metric.key}

timeseries sum(service.mule_gw_volumetrics_count), by:{channel}, from:now()-7d


fetch dt.entity.service
| filter contains(toString(tags), "APMID:APP00006805")
| fieldsAdd entity.name, id, sends_to

fetch dt.entity.host
| filter contains(entity.name, "mule") or contains(toString(tags), "Mule") or contains(toString(tags), "MuleSoft")
| fieldsAdd entity.name, id, tags
| limit 20


fetch dt.entity.custom_device
| filter contains(entity.name, "mule") or contains(toString(tags), "Mule") or contains(toString(tags), "APMID:APP00006805")
| fieldsAdd entity.name, id, tags
| limit 20

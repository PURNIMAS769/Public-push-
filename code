timeseries {
    used_memory = avg(dt.kubernetes.resourcequota.requests_memory_used),
    max_memory = avg(dt.kubernetes.resourcequota.requests_memory)
},
by: {k8s.cluster.name, k8s.namespace.name, k8s.resourcequota.name},
from: -5m, to: -1m
| fieldsAdd used_memory = arrayLast(used_memory), max_memory = arrayLast(max_memory)
| fieldsAdd memory_used_percent = round((used_memory / max_memory) * 100, decimals: 1)
| filter k8s.namespace.name == "app00002734-paperless-inventory"
| fields k8s.cluster.name, k8s.namespace.name, k8s.resourcequota.name, used_memory, max_memory, memory_used_percent


timeseries pvc_used = avg(dt.kubernetes.persistentvolumeclaim.used), pvc_capacity = avg(dt.kubernetes.persistentvolumeclaim.capacity),
    by:{k8s.namespace.name},
    from:-24h
| filter k8s.namespace.name == "app00006805-accums-adjudication"


fetch dt.entity.cloud_application_instance
| filter namespaceName == "app00006805-accums-adjudication"
| limit 1

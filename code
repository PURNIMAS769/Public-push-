C1: Which health and state values exist on Claims servers

timeseries h = max(`sql-server.always-on.db.synchronizationHealth`, scalar: true),
           by:{device.name, availability.database.synchronization_health,
               availability.database.synchronization_state, availability.database.state}, from:-30m
| fieldsAdd hostShort = lower(splitString(device.name, ".")[0])
| lookup [
    fetch dt.entity.host
    | fields hostName = entity.name, tags
    | expand t = tags
    | filter startsWith(t, "APMID:")
    | fieldsAdd apmid = splitString(t, "APMID:")[1],
                hostShort = lower(splitString(hostName, ".")[0])
    | filter in(apmid, array($ClaimsApps))
    | summarize claimsApps = collectDistinct(apmid), by:{hostShort}
  ], sourceField: hostShort, lookupField: hostShort, prefix: "h."
| filter isNotNull(h.claimsApps)
| summarize databases = count(),
            by:{availability.database.synchronization_health,
                availability.database.synchronization_state,
                availability.database.state}



C2: normal lag values (run first)
timeseries lag = avg(postgres.replication.replay_lag, scalar: true),
           by:{device.name, client_hostname, sync_state, state}, from:-2h
| summarize links = count(), minLag = min(lag), avgLag = round(avg(lag), decimals:3),
            maxLag = max(lag), by:{state}

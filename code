ffetch dt.davis.problems
| filter not(dt.davis.is_duplicate) and event.status == "ACTIVE"
| filter matchesPhrase(event.name, "Major_WindowsService_MSSQL")
| lookup [fetch dt.entity.host | fields id, hn = entity.name], sourceField:runs_on[dt.entity.host], lookupField:id, prefix:"h_"
| fields event.name, runs_on[dt.entity.host], h_hn
| limit 20

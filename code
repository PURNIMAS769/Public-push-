fetch dt.entity.host
| filter arrayIndexOf(tags, "APMID:APP00002734") > -1
| fieldsAdd host_id = id
| fieldsAdd pg_ids = runs[dt.entity.process_group]
| expand pg_ids
| fieldsAdd process_name = entityName(pg_ids, type:"dt.entity.process_group")
| fields pg_ids, process_name, host_name = entity.name, host_id
| join [
    timeseries
        gc_count = avg(dt.runtime.jvm.gc.collection_count, scalar:true, default:0),
        gc_time = avg(dt.runtime.jvm.gc.collection_time, scalar:true, default:0),
    by: { dt.entity.process_group }
  ],
  kind: leftOuter,
  on: left[pg_ids] == right[`dt.entity.process_group`],
  fields: { gc_count, gc_time }
| fieldsAdd `Avg GC Pause (ms)` = if(gc_count > 0, round(gc_time / gc_count, decimals:2), else: 0)
| fields
    `Host` = host_name,
    `Process` = process_name,
    `GC Count` = gc_count,
    `GC Time (ms)` = gc_time,
    `Avg GC Pause (ms)`
| sort `Avg GC Pause (ms)` desc
| limit 20






